// Firestore Security Rules for SmartShop Admin Role System
// Copy this to your Firebase Console > Firestore > Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return request.auth.uid == uid;
    }

    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return getUserRole(request.auth.uid) == 'admin';
    }

    // ===== USERS COLLECTION =====
    // Each user can manage their own profile
    // Users can verify their own admin status
    match /users/{uid} {
      // Anyone can read their own user data
      allow read: if isSignedIn() && isUser(uid);

      // Users can create/update their own profile (during registration)
      allow create: if isSignedIn() && isUser(uid);

      // Users can update their own profile BUT not change their role manually
      // (role changes only via server-side functions or admin verification)
      allow update: if isSignedIn() && isUser(uid) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().has('role'));

      // No delete for regular users
      allow delete: if false;
    }

    // ===== ADMIN ACCESS =====
    // Only admins can manage other users or change roles
    match /users/{uid} {
      allow update: if isAdmin() &&
                       request.resource.data.role in ['admin', 'user'];
    }

    // ===== SETTINGS COLLECTION =====
    // Admin codes should only be readable by backend/admin functions
    // Regular users should NOT be able to read this
    match /settings/{document=**} {
      // No read access for regular users
      allow read: if isAdmin();

      // Only admins can write
      allow write: if isAdmin();

      // Block anonymous users completely
      allow read, write: if false;
    }

    // ===== PRODUCTS COLLECTION =====
    match /products/{document=**} {
      // Anyone can read products
      allow read: if isSignedIn();

      // Only admins can create/update/delete products
      allow create, update, delete: if isAdmin();
    }

    // ===== CATEGORIES COLLECTION =====
    match /categories/{document=**} {
      // Anyone can read categories
      allow read: if isSignedIn();

      // Only admins can modify categories
      allow create, update, delete: if isAdmin();
    }

    // ===== ORDERS COLLECTION =====
    match /orders/{document=**} {
      // Users can read/create their own orders
      allow read, create: if isSignedIn() && isUser(resource.data.userId);

      // Users can only update specific fields in their orders
      allow update: if isSignedIn() && isUser(resource.data.userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().has('status');

      // Admins can read and update all orders (including status)
      allow read, update: if isAdmin();

      // Only admins can delete orders
      allow delete: if isAdmin();
    }

    // ===== WISHLIST COLLECTION =====
    match /wishlist/{uid}/{document=**} {
      // Users can manage their own wishlist
      allow read, write: if isSignedIn() && isUser(uid);
    }

    // ===== CART COLLECTION =====
    match /cart/{uid}/{document=**} {
      // Users can manage their own cart
      allow read, write: if isSignedIn() && isUser(uid);
    }

    // ===== DEFAULT DENY =====
    // Deny everything by default (least privilege)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/*
NOTES:
1. Replace these rules in Firebase Console > Firestore > Rules tab
2. Publish the rules before using the app
3. Users can ONLY change their own profile except role field
4. Admin codes are protected from regular users
5. Regular users cannot see other users' data
6. Orders are protected - users can't change status
7. All changes are logged by Firebase automatically

TESTING THE RULES:
- Test as authenticated user: Should see own profile
- Test as admin: Should see settings/admin_codes
- Test as different user: Should NOT see other profile
- Test anonymous: Should be denied
*/


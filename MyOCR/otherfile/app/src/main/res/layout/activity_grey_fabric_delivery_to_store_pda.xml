<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.v_1_ui.grey_fabric_roll_issue.V1_GreyFabricRollIssueActivity">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/dp5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_black"
                    android:orientation="vertical"
                    android:padding="@dimen/dp5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp5"
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_marginRight="@dimen/dp5"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="@dimen/dp0"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="COMPANY"
                                    android:textColor="@color/black"
                                    android:textSize="10sp" />
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    app:cardCornerRadius="3dp"
                                    android:layout_marginBottom="1dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginLeft="1dp"
                                    android:layout_marginRight="1dp">
                                    <TextView
                                        android:id="@+id/companyNameTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:textSize="10sp"
                                        android:singleLine="true"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="KNITTING SOURCE"
                                    android:textColor="@color/black"
                                    android:textSize="10sp" />
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    app:cardCornerRadius="3dp"
                                    android:layout_marginBottom="1dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginLeft="1dp"
                                    android:layout_marginRight="1dp">
                                    <TextView
                                        android:id="@+id/knittingSourceNameTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:textSize="10sp"
                                        android:singleLine="true"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="KNITTING COMPANY"
                                    android:textColor="@color/black"
                                    android:singleLine="true"
                                    android:textSize="10sp" />
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    app:cardCornerRadius="3dp"
                                    android:layout_marginBottom="1dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginLeft="1dp"
                                    android:layout_marginRight="1dp">
                                    <TextView
                                        android:id="@+id/knittingCompanyNameTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:textSize="10sp"
                                        android:singleLine="true"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp5"
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_marginRight="@dimen/dp5"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="@dimen/dp0"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="LOCATION"
                                    android:textColor="@color/black"
                                    android:textSize="10sp" />
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    app:cardCornerRadius="3dp"
                                    android:layout_marginBottom="1dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginLeft="1dp"
                                    android:layout_marginRight="1dp">
                                    <TextView
                                        android:id="@+id/locationNameTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:textSize="10sp"
                                        android:singleLine="true"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="FLOOR"
                                    android:textColor="@color/black"
                                    android:textSize="10sp" />
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    app:cardCornerRadius="3dp"
                                    android:layout_marginBottom="1dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginLeft="1dp"
                                    android:layout_marginRight="1dp">
                                    <TextView
                                        android:id="@+id/floorNameTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:textSize="10sp"
                                        android:singleLine="true"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
<!--                            <LinearLayout-->
<!--                                android:layout_width="0dp"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:layout_weight="1"-->
<!--                                android:layout_marginLeft="2dp"-->
<!--                                android:layout_marginRight="2dp"-->
<!--                                android:layout_marginTop="1dp"-->
<!--                                android:layout_marginBottom="1dp"-->
<!--                                android:orientation="vertical">-->
<!--                                <TextView-->
<!--                                    android:layout_width="match_parent"-->
<!--                                    android:layout_height="wrap_content"-->
<!--                                    android:text="REMARKS"-->
<!--                                    android:textColor="@color/black"-->
<!--                                    android:textSize="10sp" />-->
<!--                                <androidx.cardview.widget.CardView-->
<!--                                    android:layout_width="match_parent"-->
<!--                                    android:layout_height="30dp"-->
<!--                                    app:cardCornerRadius="3dp"-->
<!--                                    android:layout_marginBottom="1dp"-->
<!--                                    android:layout_marginTop="2dp"-->
<!--                                    android:layout_marginLeft="1dp"-->
<!--                                    android:layout_marginRight="1dp">-->
<!--                                    <EditText-->
<!--                                        android:id="@+id/deliveryRemarkET"-->
<!--                                        android:layout_width="match_parent"-->
<!--                                        android:layout_height="match_parent"-->
<!--                                        android:background="@drawable/edit_border"/>-->
<!--                                </androidx.cardview.widget.CardView>-->
<!--                            </LinearLayout>-->
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/dp5"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:layout_marginTop="1dp"
                                    android:layout_marginBottom="1dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="PURPOSE"
                                        android:textColor="@color/black"
                                        android:textSize="10sp" />
                                    <androidx.cardview.widget.CardView
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        app:cardCornerRadius="3dp"
                                        android:layout_marginBottom="1dp"
                                        android:layout_marginTop="2dp"
                                        android:layout_marginLeft="1dp"
                                        android:layout_marginRight="1dp">
                                        <Spinner
                                            android:id="@+id/purposeSpinner"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"/>
                                    </androidx.cardview.widget.CardView>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:layout_marginTop="1dp"
                                    android:layout_marginBottom="1dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="ISSUE DATE"
                                        android:textColor="@color/black"
                                        android:textSize="10sp" />
                                    <androidx.cardview.widget.CardView
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        app:cardCornerRadius="3dp"
                                        android:layout_marginBottom="1dp"
                                        android:layout_marginTop="2dp"
                                        android:layout_marginLeft="1dp"
                                        android:layout_marginRight="1dp">
                                        <androidx.appcompat.widget.AppCompatButton
                                            android:id="@+id/issueDateBtn"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="@color/white"/>
                                    </androidx.cardview.widget.CardView>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:layout_marginTop="1dp"
                                    android:layout_marginBottom="1dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="BATCH NUMBER"
                                        android:textColor="@color/black"
                                        android:textSize="10sp" />
                                    <androidx.cardview.widget.CardView
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        app:cardCornerRadius="3dp"
                                        android:layout_marginBottom="1dp"
                                        android:layout_marginTop="2dp"
                                        android:layout_marginLeft="1dp"
                                        android:layout_marginRight="1dp">
                                        <androidx.appcompat.widget.AppCompatButton
                                            android:id="@+id/batchNumber"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="@color/white"/>
                                    </androidx.cardview.widget.CardView>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                app:cardCornerRadius="@dimen/dp5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/border_black"
                    android:orientation="vertical"
                    android:padding="@dimen/dp5">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="@dimen/dp0"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="@dimen/dp5"
                                app:cardCornerRadius="@dimen/dp5">
                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/barcodeScanBT"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp30"
                                    android:textColor="@color/basePressColor"
                                    android:drawableRight="@drawable/ic_baseline_qr_code_scanner_24_1"
                                    android:text="BARCODE NO"
                                    android:background="#324F5C"
                                    android:textSize="10sp"
                                    android:padding="@dimen/dp5"/>
                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="@dimen/dp5"
                                app:cardCornerRadius="@dimen/dp5">
                                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                                    android:id="@+id/barcodeScanTV"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp30"
                                    android:text=""
                                    android:editable="false"
                                    android:textColor="@color/black"
                                    android:textSize="10sp"
                                    android:gravity="center"
                                    android:background="@drawable/edit_border"
                                    android:padding="@dimen/dp5"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="@dimen/dp0"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="@dimen/dp5"
                                app:cardCornerRadius="@dimen/dp5">
                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/challanNoScanBT"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp30"
                                    android:textColor="@color/basePressColor"
                                    android:text="CHALLAN NO"
                                    android:background="#324F5C"
                                    android:textSize="10sp"
                                    android:padding="@dimen/dp5"/>
                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="@dimen/dp5"
                                app:cardCornerRadius="@dimen/dp5">
                                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                                    android:id="@+id/challanNoScanTV"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp30"
                                    android:text=""
                                    android:editable="false"
                                    android:textColor="@color/black"
                                    android:textSize="10sp"
                                    android:gravity="center"
                                    android:background="@drawable/edit_border"
                                    android:padding="@dimen/dp5"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp5"
                android:layout_marginLeft="@dimen/dp5"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/totalRollTV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total No of Roll : "
                    android:gravity="center|left"
                    android:textColor="#000"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:padding="@dimen/dp5"
                    android:layout_margin="@dimen/dp2"/>
                <TextView
                    android:id="@+id/totalWeightTV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Weight : "
                    android:gravity="center|right"
                    android:textColor="#000"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:padding="@dimen/dp5"
                    android:layout_margin="@dimen/dp2"/>
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                app:cardBackgroundColor="@color/ballReleaseColor"
                app:cardCornerRadius="@dimen/dp5">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp1"
                    app:cardCornerRadius="@dimen/dp5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp40"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/serialTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="@dimen/dp5"
                            android:text="SL"
                            android:textColor="@color/blue_black_light"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@color/ballReleaseColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight=".3"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/qrCodeClick"
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:src="@drawable/ic_baseline_qr_code_2_24_black" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@color/ballReleaseColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|left"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="2"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/rfidItemTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:gravity="center|left"
                                android:text="Barcode"
                                android:textColor="@color/black_effective"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@color/ballReleaseColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|left"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/wightTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:gravity="center|left"
                                android:text="Weight"
                                android:textColor="@color/black_effective"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight=".3"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/deleteBtn"
                                android:layout_width="@dimen/dp30"
                                android:layout_height="@dimen/dp30"
                                android:visibility="gone"
                                android:src="@drawable/ic_baseline_delete_forever_24_red" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/outPutListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                android:layout_weight="1"
                android:visibility="visible"
                app:cardCornerRadius="@dimen/dp5">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/barcodeRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:itemCount="15"
                    tools:listitem="@layout/transfer_layout" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_centerInParent="true"/>
</RelativeLayout>
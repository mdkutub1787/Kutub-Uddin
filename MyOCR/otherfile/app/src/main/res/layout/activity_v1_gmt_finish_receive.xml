<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.v_1_ui.finish_fabric_roll_receive.V1_GmtFinishReceiveActivity">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/full_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/baseReleaseColor"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/dp10"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/back"
                            android:layout_width="@dimen/dp30"
                            android:layout_height="@dimen/dp30"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_back_white_24px"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="@dimen/dp0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="GMT Finising Receive v1"
                        android:textColor="@color/white"
                        android:gravity="center|left"
                        android:layout_marginLeft="@dimen/dp15"
                        android:textSize="24sp"/>
                    <LinearLayout
                        android:id="@+id/printerLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="@dimen/dp5"
                        android:visibility="gone"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/printerImage"
                            android:layout_width="@dimen/dp30"
                            android:layout_height="@dimen/dp30"
                            android:src="@drawable/notconnectedprinter"
                            android:textColor="@color/white"
                            android:layout_gravity="center"
                            android:gravity="center"/>
                        <TextView
                            android:id="@+id/posPrinterSelectTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:text="Not Connected"
                            android:textColor="@color/white"
                            android:layout_gravity="center"
                            android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/saveBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_margin="@dimen/dp5"
                            android:background="@drawable/approve_approve_background"
                            android:textColor="@color/white"
                            android:text="SAVE"
                            />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/refreshBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_margin="@dimen/dp5"
                            android:background="@drawable/refresh_background"
                            android:textColor="@color/white"
                            android:text="REFRESH"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                app:cardCornerRadius="@dimen/dp5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/border_black"
                    android:orientation="vertical"
                    android:padding="@dimen/dp5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp5"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                app:cardCornerRadius="5dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="PO Company"
                                        android:singleLine="true"
                                        android:textColor="@color/dashboard_text_light" />
                                    <Spinner
                                        android:id="@+id/poCompanySpinner"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp35"
                                        android:background="@drawable/edit_border"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                app:cardCornerRadius="5dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Finishing Company"
                                        android:singleLine="true"
                                        android:textColor="@color/dashboard_text_light" />
                                    <Spinner
                                        android:id="@+id/finishCompanySpinner"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp35"
                                        android:background="@drawable/edit_border"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                app:cardCornerRadius="5dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Finishing Location"
                                        android:textColor="@color/dashboard_text_light"/>
                                    <Spinner
                                        android:id="@+id/fnLocationSpinner"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp35"
                                        android:background="@drawable/edit_border"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:visibility="gone"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                app:cardCornerRadius="5dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Identify Number"
                                        android:textColor="@color/dashboard_text_light"/>
                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/macAddressBtn"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp45"
                                        android:background="@drawable/edit_border"
                                        android:text="FF:FF:FF:FF:FF:FF"
                                        android:gravity="center"
                                        android:textSize="18sp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp5"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                app:cardCornerRadius="5dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Finishing Floor"
                                        android:textColor="@color/dashboard_text_light" />
                                    <Spinner
                                        android:id="@+id/fnFloorSpinner"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp35"
                                        android:background="@drawable/edit_border"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                app:cardCornerRadius="5dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Line"
                                        android:textColor="@color/dashboard_text_light" />
                                    <Spinner
                                        android:id="@+id/fnLineSpinnner"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp35"
                                        android:background="@drawable/edit_border"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                app:cardCornerRadius="5dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Current Date"
                                        android:textColor="@color/dashboard_text_light" />
                                    <TextView
                                        android:id="@+id/currentDateTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp35"
                                        android:gravity="center"
                                        android:background="@drawable/edit_border"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            tools:ignore="UselessParent">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp5"
                                android:layout_weight="1"
                                app:cardCornerRadius="@dimen/dp5"
                                tools:ignore="NestedWeights">

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/btBarcodeScan"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp35"
                                    android:background="#324F5C"
                                    android:drawableEnd="@drawable/ic_baseline_qr_code_scanner_24_1"
                                    android:padding="@dimen/dp5"
                                    android:text="Barcode"
                                    android:textColor="@color/basePressColor"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp5"
                                android:layout_weight="1"
                                app:cardCornerRadius="@dimen/dp5">

                                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                                    android:id="@+id/btBarcodeScanTV"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp35"
                                    android:background="@drawable/edit_border"
                                    android:editable="false"
                                    android:gravity="center"
                                    android:padding="@dimen/dp5"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <androidx.cardview.widget.CardView
                    android:id="@+id/outPutListCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp5"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginRight="@dimen/dp5"
                    app:cardCornerRadius="@dimen/dp5">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp5"
                            android:layout_marginTop="@dimen/dp5"
                            android:layout_marginRight="@dimen/dp5"
                            app:cardBackgroundColor="@color/baseReleaseColor"
                            app:cardCornerRadius="@dimen/dp5">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp1"
                                app:cardCornerRadius="@dimen/dp5">

                                <LinearLayout
                                    android:background="@color/blue_50"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp40"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:visibility="invisible"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center|right"
                                        android:orientation="horizontal"
                                        tools:ignore="RtlHardcoded">

                                        <CheckBox
                                            android:id="@+id/unSelectCheckBox"
                                            android:layout_width="@dimen/dp40"
                                            android:layout_height="@dimen/dp40"
                                            android:enabled="false" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/serialTV"
                                        android:layout_width="@dimen/dp30"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:layout_margin="@dimen/dp5"
                                        android:text="SL"
                                        android:textColor="@color/blue_black_light"
                                        tools:ignore="HardcodedText" />

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:background="@color/ballReleaseColor" />

                                    <LinearLayout
                                        android:layout_width="@dimen/dp150"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginStart="@dimen/dp10"
                                        android:orientation="vertical"
                                        tools:ignore="RtlHardcoded">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="left"
                                            android:gravity="center"
                                            android:text="Bundle No"
                                            android:textColor="@color/black_effective"
                                            android:textSize="14sp"
                                            android:textStyle="bold"
                                            tools:ignore="HardcodedText" />
                                    </LinearLayout>
                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:background="@color/ballReleaseColor" />

                                    <LinearLayout
                                        android:layout_width="@dimen/dp100"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginStart="@dimen/dp10"
                                        android:orientation="vertical"
                                        tools:ignore="RtlHardcoded">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="left"
                                            android:gravity="center"
                                            android:text="Int. Booking"
                                            android:textColor="@color/black_effective"
                                            android:textSize="14sp"
                                            android:textStyle="bold"
                                            tools:ignore="HardcodedText" />
                                    </LinearLayout>

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:background="@color/ballReleaseColor" />

                                    <LinearLayout
                                        android:layout_width="@dimen/dp120"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:orientation="vertical"
                                        tools:ignore="RtlHardcoded">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="left"
                                            android:gravity="center"
                                            android:text="Item"
                                            android:textColor="@color/black_effective"
                                            android:textSize="14sp"
                                            android:textStyle="bold"
                                            tools:ignore="HardcodedText" />
                                    </LinearLayout>

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:background="@color/ballReleaseColor" />

                                    <LinearLayout
                                        android:layout_width="@dimen/dp150"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:orientation="vertical"
                                        tools:ignore="RtlHardcoded">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="left"
                                            android:gravity="center"
                                            android:text="Color"
                                            android:textColor="@color/black_effective"
                                            android:textSize="14sp"
                                            android:textStyle="bold"
                                            tools:ignore="HardcodedText" />
                                    </LinearLayout>

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:background="@color/ballReleaseColor" />

                                    <LinearLayout
                                        android:layout_width="@dimen/dp70"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:orientation="vertical"
                                        tools:ignore="RtlHardcoded">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="left"
                                            android:gravity="center"
                                            android:text="Size"
                                            android:textColor="@color/black_effective"
                                            android:textSize="14sp"
                                            android:textStyle="bold"
                                            tools:ignore="HardcodedText" />
                                    </LinearLayout>

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:background="@color/ballReleaseColor" />

                                    <LinearLayout
                                        android:layout_width="@dimen/dp120"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:orientation="vertical"
                                        tools:ignore="RtlHardcoded">
                                        <TextView
                                            android:id="@+id/weightTV"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="left"
                                            android:gravity="center"
                                            android:text="Bundle Qnty"
                                            android:textColor="@color/black_effective"
                                            android:textSize="14sp"
                                            android:textStyle="bold"
                                            tools:ignore="HardcodedText" />
                                    </LinearLayout>
                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:background="@color/ballReleaseColor" />

                                    <LinearLayout
                                        android:layout_width="@dimen/dp120"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:orientation="vertical"
                                        tools:ignore="RtlHardcoded">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="left"
                                            android:gravity="center"
                                            android:text="Fin. Rcv Qnty"
                                            android:textColor="@color/black_effective"
                                            android:textSize="14sp"
                                            android:textStyle="bold"
                                            tools:ignore="HardcodedText" />
                                    </LinearLayout>



                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginLeft="@dimen/dp5"
                            android:layout_marginTop="@dimen/dp5"
                            android:layout_marginRight="@dimen/dp5"
                            android:layout_weight="1"
                            android:visibility="visible"
                            app:cardCornerRadius="@dimen/dp5">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/finishReceiveRecyclerView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                tools:itemCount="3"
                                tools:listitem="@layout/gtm_finish_receive_layout" />
                        </androidx.cardview.widget.CardView>
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="@dimen/dp5"
                            android:layout_marginBottom="@dimen/dp3"
                            app:cardBackgroundColor="@color/ash">
                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp1"
                                app:cardCornerRadius="@dimen/dp5">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp40"
                                    android:orientation="horizontal"
                                    android:layout_gravity="center|right"
                                    android:gravity="right">
                                    <LinearLayout
                                        android:layout_width="@dimen/dp120"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:layout_gravity="center"
                                        android:orientation="vertical">
                                        <TextView
                                            android:id="@+id/totalBundleQNtyTV"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text=""
                                            android:textSize="14sp"
                                            android:textColor="@color/black_effective"

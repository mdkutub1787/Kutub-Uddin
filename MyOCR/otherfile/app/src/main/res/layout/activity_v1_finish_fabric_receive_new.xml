<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.v_1_ui.finish_fabric.finish_fabric_receive.V1_Finish_Fabric_Receive">

    <ProgressBar
        android:id="@+id/loading_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/full_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                app:cardCornerRadius="@dimen/dp5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/border_black"
                    android:orientation="vertical"
                    android:padding="@dimen/dp5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            tools:ignore="UselessParent">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp5"
                                android:layout_weight="1"
                                app:cardCornerRadius="@dimen/dp5"
                                tools:ignore="NestedWeights">

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/btFrRackScan"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp50"
                                    android:background="#324F5C"
                                    android:drawableEnd="@drawable/ic_baseline_qr_code_scanner_24_1"
                                    android:padding="@dimen/dp5"
                                    android:text="Fr. Rack Scan"
                                    android:textColor="@color/basePressColor"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp5"
                                android:layout_weight="1"
                                app:cardCornerRadius="@dimen/dp5">

                                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                                    android:id="@+id/btFrRackScanTV"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp50"
                                    android:background="@drawable/edit_border"
                                    android:editable="false"
                                    android:gravity="center"
                                    android:padding="@dimen/dp5"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            tools:ignore="UselessParent">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp5"
                                android:layout_weight="1"
                                app:cardCornerRadius="@dimen/dp5"
                                tools:ignore="NestedWeights">

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/btBarcodeScan"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp50"
                                    android:background="#324F5C"
                                    android:drawableEnd="@drawable/ic_baseline_qr_code_scanner_24_1"
                                    android:padding="@dimen/dp5"
                                    android:text="Barcode Scan"
                                    android:textColor="@color/basePressColor"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp5"
                                android:layout_weight="1"
                                app:cardCornerRadius="@dimen/dp5">

                                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                                    android:id="@+id/btBarcodeScanTV"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp50"
                                    android:background="@drawable/edit_border"
                                    android:editable="false"
                                    android:gravity="center"
                                    android:padding="@dimen/dp5"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            tools:ignore="UselessParent">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp5"
                                android:layout_weight="1"
                                app:cardCornerRadius="@dimen/dp5"
                                tools:ignore="NestedWeights">

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/btBatchCardScan"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp50"
                                    android:background="#324F5C"
                                    android:padding="@dimen/dp5"
                                    android:text="Batch Card No"
                                    android:textColor="@color/basePressColor"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp5"
                                android:layout_weight="1"
                                app:cardCornerRadius="@dimen/dp5">

                                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                                    android:id="@+id/btBatchCardScanTV"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp50"
                                    android:background="@drawable/edit_border"
                                    android:editable="false"
                                    android:gravity="center"
                                    android:padding="@dimen/dp5"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp5"
                        android:background="@drawable/edit_border"
                        android:orientation="horizontal"
                        android:weightSum="10"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:background="@drawable/edit_border">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                tools:ignore="UselessParent">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Receive to location"
                                    android:textAlignment="center"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/edit_border"
                                    android:orientation="horizontal"
                                    android:weightSum="10">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="7"
                                        android:background="@drawable/edit_border"
                                        android:text="Total roll"
                                        android:textAlignment="center"
                                        android:textStyle="italic"
                                        tools:ignore="HardcodedText,TooDeepLayout" />

                                    <TextView
                                        android:id="@+id/totalRollCountTV"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="3"
                                        android:text="0"
                                        android:textAlignment="center"
                                        tools:ignore="HardcodedText" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="6">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                tools:ignore="UselessParent">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Text"
                                    android:textAlignment="center"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/edit_border"
                                    android:orientation="horizontal"
                                    android:weightSum="10">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="3"
                                        android:background="@drawable/edit_border"
                                        android:text="scan roll"
                                        android:textAlignment="center"
                                        android:textStyle="italic"
                                        tools:ignore="HardcodedText" />

                                    <TextView
                                        android:id="@+id/totalScanRollTV"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="2"
                                        android:text="0"
                                        android:textAlignment="center"
                                        tools:ignore="HardcodedText" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="3"
                                        android:background="@drawable/edit_border"
                                        android:text="Balance"
                                        android:textAlignment="center"
                                        android:textStyle="italic"
                                        tools:ignore="HardcodedText" />

                                    <TextView
                                        android:id="@+id/totalBalanceTV"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="2"
                                        android:text="0"
                                        android:textAlignment="center"
                                        tools:ignore="HardcodedText" />
                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            tools:ignore="UselessParent">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp5"
                                android:layout_weight="1"
                                app:cardCornerRadius="@dimen/dp5"
                                tools:ignore="NestedWeights">

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/saveBT"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp50"
                                    android:background="#4CAF50"
                                    android:padding="@dimen/dp5"
                                    android:text="Save"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp5"
                                android:layout_weight="1"
                                app:cardCornerRadius="@dimen/dp5">

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/refreshBT"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp50"
                                    android:background="#FF9800"
                                    android:padding="@dimen/dp5"
                                    android:text="Refresh"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                app:cardBackgroundColor="@color/baseReleaseColor"
                app:cardCornerRadius="@dimen/dp5">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp1"
                    app:cardCornerRadius="@dimen/dp5">

                    <LinearLayout
                        android:background="@color/blue_50"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp40"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/serialTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="@dimen/dp5"
                            android:text="S"
                            android:textColor="@color/blue_black_light"
                            tools:ignore="HardcodedText" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@color/ballReleaseColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight=".3"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/qrCodeClick"
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:src="@drawable/ic_baseline_qr_code_2_24_black"
                                tools:ignore="ContentDescription" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@color/ballReleaseColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|left"
                            android:layout_marginStart="@dimen/dp10"
                            android:layout_weight="2"
                            android:orientation="vertical"
                            tools:ignore="RtlHardcoded">

                            <TextView
                                android:id="@+id/barcodeTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:gravity="center|left"
                                android:text="Barcode"
                                android:textColor="@color/black_effective"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@color/ballReleaseColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|left"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            tools:ignore="RtlHardcoded">

                            <TextView
                                android:id="@+id/weightTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:gravity="center|left"
                                android:text="Weight"
                                android:textColor="@color/black_effective"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <LinearLayout
                            android:visibility="invisible"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="2"
                            android:gravity="center|right"
                            android:orientation="horizontal"
                            tools:ignore="RtlHardcoded">

                            <CheckBox
                                android:id="@+id/unSelectCheckBox"
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                android:enabled="false" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/outPutListCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                android:layout_weight="1"
                android:visibility="visible"
                app:cardCornerRadius="@dimen/dp5">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/finishRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:itemCount="10"
                    tools:listitem="@layout/gtm_finish_fabric_recycler_layout" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

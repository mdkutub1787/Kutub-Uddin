<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.v_1_ui.finishing.V1_FinishingForPdaActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@color/baseReleaseColor"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/dp10"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/back"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_back_white_24px"/>
                </LinearLayout>
                <TextView
                    android:layout_width="@dimen/dp0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Finishing"
                    android:textColor="@color/white"
                    android:gravity="center|left"
                    android:layout_marginLeft="@dimen/dp15"
                    android:textSize="24sp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/refreshBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/dp5"
                        android:background="@drawable/refresh_background"
                        android:textColor="@color/white"
                        android:text="EDIT"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/saveBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/dp5"
                        android:background="@drawable/approve_approve_background"
                        android:textColor="@color/white"
                        android:text="SAVE"
                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/dp2"
                    android:layout_margin="@dimen/dp2"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_black"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp2"
                            android:layout_marginRight="@dimen/dp2"
                            android:layout_marginLeft="@dimen/dp2"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/dashboard_text_light"
                                    android:textSize="12sp"
                                    android:text="Receive Date"/>
                                <TextView
                                    android:id="@+id/receiveDateTV"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp35"
                                    android:gravity="center|left"
                                    android:paddingLeft="@dimen/dp2"
                                    android:textStyle="bold"
                                    android:textSize="12sp"
                                    android:text="12-Dec-2022"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp2"
                    android:layout_marginRight="@dimen/dp2"
                    app:cardCornerRadius="@dimen/dp2">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/dp2"
                        android:padding="@dimen/dp2">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="horizontal">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp2"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/batchScanBT"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/basePressColor"
                                        android:drawableRight="@drawable/ic_baseline_qr_code_scanner_24_1"
                                        android:text="BATCH NO"
                                        android:background="#324F5C"
                                        android:textSize="12sp"
                                        android:padding="@dimen/dp1"/>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp2"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                                        android:id="@+id/batchScanTV"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/black"
                                        android:editable="false"
                                        android:textSize="12sp"
                                        android:text=""
                                        android:gravity="center"
                                        android:background="@drawable/edit_border"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:visibility="gone"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <ImageButton
                                        android:id="@+id/roomRackRefreshBT"
                                        android:layout_width="@dimen/dp20"
                                        android:layout_height="@dimen/dp20"
                                        android:background="@drawable/icons_refresh"
                                        android:layout_gravity="center"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="horizontal">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/machineScanBT"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/basePressColor"
                                        android:drawableRight="@drawable/ic_baseline_qr_code_scanner_24_1"
                                        android:text="MACHINE NO"
                                        android:background="#324F5C"
                                        android:textSize="12sp"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                                        android:id="@+id/machineScanTV"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:text=""
                                        android:editable="false"
                                        android:textColor="@color/black"
                                        android:textSize="12sp"
                                        android:gravity="center"
                                        android:background="@drawable/edit_border"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:visibility="gone"
                                    android:layout_margin="@dimen/dp2"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <ImageButton
                                        android:id="@+id/barcodeRefreshBT"
                                        android:layout_width="@dimen/dp20"
                                        android:layout_height="@dimen/dp20"
                                        android:background="@drawable/icons_refresh"
                                        android:layout_gravity="center"
                                        android:padding="@dimen/dp20"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/dp5"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Process"/>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <Spinner
                                        android:id="@+id/processSpinner"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/black"
                                        android:editable="false"
                                        android:text=""
                                        android:textSize="12sp"
                                        android:gravity="center"
                                        android:background="@drawable/edit_border"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Extension No"/>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <TextView
                                        android:id="@+id/extentionNoTV"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/black"
                                        android:text=""
                                        android:textSize="12sp"
                                        android:gravity="center"
                                        android:background="@drawable/textviewshape"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/dp5"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Start Date"/>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <TextView
                                        android:id="@+id/startDateTV"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/black"
                                        android:text=""
                                        android:textSize="12sp"
                                        android:gravity="center"
                                        android:background="@drawable/textviewshape"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Start Time"/>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <TextView
                                        android:id="@+id/startTimeTV"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/black"
                                        android:text=""
                                        android:textSize="12sp"
                                        android:gravity="center"
                                        android:background="@drawable/textviewshape"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/dp5"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="End Date"/>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <TextView
                                        android:id="@+id/endDateTV"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/black"
                                        android:text=""
                                        android:textSize="12sp"
                                        android:gravity="center"
                                        android:background="@drawable/textviewshape"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="End Time"/>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <TextView
                                        android:id="@+id/endTimeTV"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/black"
                                        android:text=""
                                        android:textSize="12sp"
                                        android:gravity="center"
                                        android:background="@drawable/textviewshape"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/dp5"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Total Roll"/>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <TextView
                                        android:id="@+id/totalRollTV"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/black"
                                        android:text=""
                                        android:textSize="12sp"
                                        android:gravity="center"
                                        android:background="@drawable/textviewshape"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Batch Weight"/>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <TextView
                                        android:id="@+id/batchWeightTV"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:textColor="@color/black"
                                        android:text=""
                                        android:textSize="12sp"
                                        android:gravity="center"
                                        android:background="@drawable/textviewshape"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/dp5"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/subProcessTitleTV"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Sub Process"/>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp3"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <Spinner
                                        android:id="@+id/subProcessSpinner"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:background="@drawable/edit_border"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:visibility="visible">
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="horizontal">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:visibility="gone"
                                    android:layout_margin="@dimen/dp2"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/submitBT"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp60"
                                        android:textColor="@color/white"
                                        android:textSize="16sp"
                                        android:text="Submit"
                                        android:background="#00BCD4"
                                        android:padding="@dimen/dp20"/>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/dp35"
                                    android:layout_weight="1"
                                    android:layout_marginTop="@dimen/dp10"
                                    app:cardCornerRadius="@dimen/dp2">
                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/startBT"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:textColor="@color/white"
                                        android:textSize="14sp"
                                        android:text="START"
                                        android:background="#4CAF50"
                                        android:padding="@dimen/dp2"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>


    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_centerInParent="true"/>
</RelativeLayout>
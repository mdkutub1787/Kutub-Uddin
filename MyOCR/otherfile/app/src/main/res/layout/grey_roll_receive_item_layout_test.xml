<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp5"
        app:cardBackgroundColor="@color/ballReleaseColor">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/dp5"
            android:layout_margin="@dimen/dp1"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:id="@+id/ly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/white">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp2"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_marginBottom="@dimen/dp5"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom"
                                app:cardCornerRadius="@dimen/dp5">
                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/removeBT"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp40"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:layout_gravity="center"
                                    android:text="Remove"
                                    android:drawableRight="@drawable/ic_baseline_remove_circle_outline_24"
                                    android:background="@color/red"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="@dimen/dp5"
                                app:cardCornerRadius="@dimen/dp5">
                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/moreBT"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp40"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:layout_gravity="center"
                                    android:text="More"
                                    android:drawableRight="@drawable/ic_baseline_more_horiz_24"
                                    android:background="@color/violet_color_picker"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp5">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="@dimen/dp40"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/slTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center"
                                        android:textColor="#000"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="100"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="120dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/barcodeTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/rollTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="BHG-09876"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/rollWgtTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="BHG-09876"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:visibility="gone"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/rollWeightTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="Sleeve Join"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/fsoJobTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="500"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/fabBookingTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="Green"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/programNoTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="M"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/compositionTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/constructionTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/gsmTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/diaTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text=""/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/fabricColorTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/yarnLotTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="100dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/stitchLengthTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="100dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/brandTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
</LinearLayout>
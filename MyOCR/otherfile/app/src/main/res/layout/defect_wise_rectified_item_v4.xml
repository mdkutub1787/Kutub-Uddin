<LinearLayout xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayoutSewingIn"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="MissingDefaultResource">
    <LinearLayout
        android:id="@+id/ly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp1"
        android:orientation="horizontal">
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:gravity="center|center"
            android:layout_gravity="center|center">
            <RadioButton
                android:id="@+id/checkBox"
                android:layout_width="@dimen/dp60"
                android:layout_height="match_parent"
                android:padding="5dp"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center|center"
                android:theme="@style/MyRadioButton"
                android:button="@drawable/radio_button"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/poNumberTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="PO Number"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight=".8"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/colorTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Color"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight=".8"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/sizeTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Size"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight=".5"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/alterTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Alter"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight=".5"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/spotTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Spot"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight=".5"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/rectifiedTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Rectified"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight=".3"
                    app:cardCornerRadius="3dp"
                    android:layout_marginBottom="1dp"
                    app:cardBackgroundColor="@color/bg_color"
                    android:layout_marginTop="2dp"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:visibility="visible"
                            android:background="@drawable/edit_border"
                            android:layout_marginLeft="1dp"
                            android:layout_marginRight="1dp">
                            <androidx.appcompat.widget.AppCompatImageButton
                                android:id="@+id/defectUp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:layout_weight="1"
                                android:background="@drawable/ic_keyboard_arrow_up_black_24dp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/defectCountET"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginLeft="1dp"
                            android:layout_marginRight="1dp"
                            android:editable="false"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:background="@drawable/edit_border"
                            android:inputType="number"
                            android:layout_gravity="center"
                            android:gravity="center"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:visibility="visible"
                            android:background="@drawable/edit_border"
                            android:layout_marginLeft="1dp"
                            android:layout_marginRight="1dp">
                            <androidx.appcompat.widget.AppCompatImageButton
                                android:id="@+id/defectDown"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:layout_weight="1"
                                android:background="@drawable/ic_keyboard_arrow_down_black_24dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/dp5"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/dp5"
    android:background="@color/dashboard_grey"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".ui.process.greyroll.SewingInputActivity"
    tools:showIn="@layout/activity_finish_fabric_input">
    <androidx.cardview.widget.CardView
        android:id="@+id/item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:elevation="@dimen/dp5"
        android:layout_marginTop="@dimen/dp10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/dp10"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/dp5"
                android:paddingBottom="@dimen/dp10"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_column="0"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_date_range_black_24dp" />


                <TextView
                    android:id="@+id/tvDate"
                    style="@android:style/Widget.DeviceDefault.Light.Spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:paddingLeft="@dimen/dp20"
                    android:ems="10"
                    android:hint="Enter date" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:padding="@dimen/dp3"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".4"
                    android:textSize="@dimen/dp13"
                    android:textColor="@color/list_header_title_text_color"
                    android:textAllCaps="true"
                    android:text="Company"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".1"
                    android:textSize="@dimen/dp13"
                    android:textColor="@color/list_header_value_text_color"
                    android:text=":"/>
                <TextView
                    android:id="@+id/text_company"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".5"
                    android:textSize="@dimen/dp13"

                    android:textColor="@color/list_header_value_text_color"
                    android:text="AKH Knitting and Dyeing Ltd"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:padding="@dimen/dp3"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".4"
                    android:textSize="@dimen/dp13"
                    android:textColor="@color/list_header_title_text_color"
                    android:textAllCaps="true"
                    android:text="Service Source"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".1"
                    android:textSize="@dimen/dp13"
                    android:textColor="@color/list_header_value_text_color"
                    android:text=":"/>
                <TextView
                    android:id="@+id/text_service_source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".5"
                    android:textSize="@dimen/dp13"

                    android:textColor="@color/list_header_value_text_color"
                    android:text="In-house"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:padding="@dimen/dp3"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".4"
                    android:textSize="@dimen/dp13"
                    android:textColor="@color/list_header_title_text_color"
                    android:textAllCaps="true"
                    android:text="Service Company"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".1"
                    android:textSize="@dimen/dp13"
                    android:textColor="@color/list_header_value_text_color"
                    android:text=":"/>
                <TextView
                    android:id="@+id/text_service_company"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".5"
                    android:textSize="@dimen/dp13"

                    android:textColor="@color/list_header_value_text_color"
                    android:text="AKH Knitting and Dyeing Ltd"/>

            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_grey_roll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/item_card"
        android:clickable="true"
        android:scrollIndicators="none" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_margin="@dimen/dp16"
        app:srcCompat="@drawable/ic_add_white_24dp" />

</RelativeLayout>

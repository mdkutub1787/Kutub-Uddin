<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.v_1_ui.report.V1_BundleTrackingReportActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">
        <LinearLayout
            android:id="@+id/liniarlayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:layout_marginRight="30dp"
            android:layout_marginLeft="30dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/allinfoBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:visibility="gone"

                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="All INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/allinfoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:visibility="gone"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:text="All INFO"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/bundleNoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:gravity="center"
                android:textSize="14sp"
                android:background="@null"
                android:layout_marginTop="2dp"
                android:textColor="#0091EA"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:textStyle="bold"
                android:inputType="text" />

            <TextView
                android:id="@+id/order_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:gravity="center"
                android:textSize="14sp"
                android:visibility="gone"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:text="ORDER INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/order_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:text="All INFO" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/cut_and_lay_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="CUT AND LAY INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/cut_and_lay_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:textColor="#000000"
                        android:text="All INFO" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/cutting_qc_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="CUTTING QC INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/cutting_qc_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:textColor="#000000"
                        android:text="All INFO"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/print_issue_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="PRINT ISSUE INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/print_issue_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:textColor="#000000"
                        android:text="All INFO"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/print_receive_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="PRINT RECEIVE INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/print_receive_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:textColor="#000000"
                        android:text="All INFO"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/embroidery_issue_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"

                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="EMPBROIDERY ISSUE INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/embroidery_issue_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:textColor="#000000"
                        android:text="All INFO"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/embroidery_receive_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"

                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="EMPBROIDERY RECEIVE INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/embroidery_receive_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:textColor="#000000"
                        android:text="All INFO"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/sewing_issue_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"

                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="SEWING INPUT INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/sewing_issue_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:textColor="#000000"
                        android:text="All INFO"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/sewing_receive_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"

                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="SEWING OUTPUT INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/sewing_receive_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:textColor="#000000"
                        android:text="All INFO"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/line_input_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"

                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="LINE INPUT INFO"
                android:textStyle="bold"
                android:inputType="text" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/line_input_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:textColor="#000000"
                        android:text="All INFO"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/line_output_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textColorHighlight="@color/white"
                android:gravity="center"
                android:textSize="14sp"
                android:text="LINE OUTPUT INFO"
                android:textStyle="bold"
                android:inputType="text" />


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/line_output_infoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:textColor="#000000"
                        android:text="All INFO"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp2"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:id="@+id/markedCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp5">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/edit_card_border">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginRight="@dimen/dp10"
                                android:layout_marginLeft="@dimen/dp10"
                                android:layout_marginTop="@dimen/dp10">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text=""
                                    android:textStyle="bold"
                                    android:textColor="@color/blue_black_dark"
                                    android:textSize="@dimen/sp16"/>
                                <ImageView
                                    android:layout_width="@dimen/dp12"
                                    android:layout_height="@dimen/dp12"
                                    android:layout_gravity="center"
                                    android:src="@drawable/rounded_button"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginRight="@dimen/dp10"
                                android:layout_marginLeft="@dimen/dp10"
                                android:layout_marginTop="@dimen/dp10"
                                android:layout_marginBottom="@dimen/dp5">
                                <TextView
                                    android:id="@+id/reqNumberTextField"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="New Approval request found."
                                    android:textStyle="bold"
                                    android:textColor="@color/blue_black_dark"
                                    android:textSize="@dimen/sp16"/>
                                <TextView
                                    android:id="@+id/dateTextview"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:textStyle="bold"
                                    android:text="12-12-12"
                                    android:src="@drawable/rounded_button"/>
                            </LinearLayout>
                            <TextView
                                android:id="@+id/detailsTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Requisition Id: 10679,\nStore: General Store-DnC [ICT],\nRequisition No: OG-RQSN-23-00353,\nRequisition date: 28-08-2023,\nDelivery date: 01-01-1970,\nInserted by : Hossain Mahmud Rana"
                                android:textStyle="normal"
                                android:textColor="@color/baseReleaseColor"
                                android:textSize="@dimen/sp16"
                                android:layout_marginLeft="@dimen/dp10"
                                android:layout_marginRight="@dimen/dp10" />

                            <TextView
                                android:id="@+id/dateTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Merchandising Module: 28-AUG-23"
                                android:textStyle="italic|normal"
                                android:textColor="@color/gray"
                                android:textSize="@dimen/sp12"
                                android:layout_marginLeft="@dimen/dp10"
                                android:layout_marginRight="@dimen/dp10"
                                android:layout_marginTop="@dimen/dp5"/>

                            <EditText
                                android:id="@+id/reasonET"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/edit_border"
                                android:hint="Reason"
                                android:visibility="gone"
                                android:padding="@dimen/dp5"
                                android:layout_margin="@dimen/dp5"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp30"
                        android:gravity="start"
                        android:layout_margin="@dimen/dp5"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/detailsBtn"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginRight="@dimen/dp5"
                            android:gravity="center"
                            android:textSize="@dimen/sp14"
                            android:textStyle="bold"
                            android:background="@drawable/approve_details_background"
                            android:textColor="#fff"
                            android:text="DETAILS"/>
                        <TextView
                            android:id="@+id/approveBtn"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginRight="@dimen/dp5"
                            android:gravity="center"
                            android:textSize="@dimen/sp14"
                            android:visibility="visible"
                            android:textStyle="bold"
                            android:background="@drawable/approve_approve_background"
                            android:textColor="#fff"
                            android:text="APPROVE"/>
                        <TextView
                            android:id="@+id/unApproveBtn"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginRight="@dimen/dp5"
                            android:gravity="center"
                            android:textSize="@dimen/sp14"
                            android:visibility="visible"
                            android:textStyle="bold"
                            android:background="@drawable/approve_unapprove_background"
                            android:textColor="#fff"
                            android:text="UNAPPROVED"/>
                        <TextView
                            android:id="@+id/denyBtn"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:visibility="visible"
                            android:textSize="@dimen/sp14"
                            android:textStyle="bold"
                            android:background="@drawable/approve_deny_background"
                            android:textColor="#fff"
                            android:text="DENY"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>

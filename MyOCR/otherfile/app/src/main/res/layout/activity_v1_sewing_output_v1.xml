<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.v_1_ui.bunlde_wise_sewing.V1_SewingOutputActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <androidx.cardview.widget.CardView
            android:id="@+id/sewingCompanyInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp5"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/dp5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_black"
                android:orientation="vertical"
                android:padding="@dimen/dp5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp5"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginRight="@dimen/dp5"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="@dimen/dp0"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp5"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/company"
                            android:textColor="@color/dashboard_text_light"
                            android:textStyle="bold" />
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            app:cardCornerRadius="3dp"
                            android:layout_marginBottom="1dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginLeft="1dp"
                            android:layout_marginRight="1dp">
                            <TextView
                                android:id="@+id/companyNameTV"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center|left"
                                android:paddingLeft="@dimen/dp5"
                                android:text=""
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="@dimen/dp0"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp5"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/location"
                            android:textColor="@color/dashboard_text_light"
                            android:textStyle="bold" />
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            app:cardCornerRadius="3dp"
                            android:layout_marginBottom="1dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginLeft="1dp"
                            android:layout_marginRight="1dp">
                            <TextView
                                android:id="@+id/locationTV"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center|left"
                                android:paddingLeft="@dimen/dp5"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="@dimen/dp0"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp2"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/floor"
                            android:textColor="@color/dashboard_text_light"
                            android:textStyle="bold" />
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            app:cardCornerRadius="3dp"
                            android:layout_marginBottom="1dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginLeft="1dp"
                            android:layout_marginRight="1dp">
                            <TextView
                                android:id="@+id/floorTV"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center|left"
                                android:paddingLeft="@dimen/dp5"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="@dimen/dp0"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp2"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_line"
                            android:textColor="@color/dashboard_text_light"
                            android:textStyle="bold" />
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            app:cardCornerRadius="3dp"
                            android:layout_marginBottom="1dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginLeft="1dp"
                            android:layout_marginRight="1dp">
                            <TextView
                                android:id="@+id/lineTV"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center|left"
                                android:paddingLeft="@dimen/dp5"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/dp0"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Shift Name"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="35dp"
                                    app:cardCornerRadius="3dp"
                                    android:layout_marginBottom="1dp"
                                    android:background="@drawable/edit_border"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginLeft="1dp"
                                    android:layout_marginRight="1dp">
                                    <Spinner
                                        android:id="@+id/shiftSpinner"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Organic"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:inputType="text" />
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="35dp"
                                    app:cardCornerRadius="3dp"
                                    android:layout_marginBottom="1dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginLeft="1dp"
                                    android:layout_marginRight="1dp">
                                    <CheckBox
                                        android:id="@+id/organicCheckBox"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/dp2"
                                        android:layout_weight="1"
                                        android:text="Organic"
                                        android:textColor="@color/black"
                                        android:textSize="16sp"/>
                                </androidx.cardview.widget.CardView>

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/dp0"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dp2"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Output Date"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="35dp"
                                    app:cardCornerRadius="3dp"
                                    android:layout_marginBottom="1dp"
                                    android:background="@drawable/edit_border"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginLeft="1dp"
                                    android:layout_marginRight="1dp">
                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/sewingDateBtn"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:textSize="18sp"
                                        android:background="@null"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginBottom="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Output Time"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:inputType="text" />
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="35dp"
                                    app:cardCornerRadius="3dp"
                                    android:layout_marginBottom="1dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginLeft="1dp"
                                    android:layout_marginRight="1dp">
                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/sewingTimeBtn"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:textSize="18sp"
                                        android:background="@null"/>
                                </androidx.cardview.widget.CardView>

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/sewingBarcodeScanCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp5"
            android:layout_marginRight="@dimen/dp5"
            android:visibility="visible"
            app:cardCornerRadius="@dimen/dp5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/border_black"
                android:orientation="vertical"
                android:padding="@dimen/dp5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="@dimen/dp0"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp2"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp5"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#324F5C"
                            app:cardCornerRadius="@dimen/dp5">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/input_scanBtn"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp50"
                                android:backgroundTint="#324F5C"
                                android:drawableRight="@drawable/ic_baseline_qr_code_scanner_24_1"
                                android:text="@string/bundle_scan"
                                android:textColor="@color/basePressColor"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp5"
                            android:layout_weight="1"
                            app:cardCornerRadius="@dimen/dp5">

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/barcodenumberText"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp50"
                                android:background="@drawable/edit_border"
                                android:gravity="center"
                                android:inputType="number"
                                android:padding="@dimen/dp5"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/outPutListCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp5"
            android:layout_marginRight="@dimen/dp5"
            android:layout_marginTop="@dimen/dp5"
            android:layout_weight="1"
            android:visibility="visible"
            app:cardCornerRadius="@dimen/dp5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="@dimen/dp0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/sewingInputGrid"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:dividerHeight="5.0sp"
                            android:listSelector="#02fff6"
                            android:numColumns="1"
                            android:verticalSpacing="1dp"
                            tools:itemCount="1"
                            tools:listitem="@layout/sewing_output_object_layout_v1" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/operationListCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp5"
            android:layout_marginRight="@dimen/dp5"
            android:layout_marginTop="@dimen/dp5"
            android:layout_weight="1"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/dp5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/backFromOperationButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#009688"
                            android:padding="@dimen/dp5"
                            android:text="SEWING OUTPUT"
                            android:drawableLeft="@drawable/ic_arrow_back_white_24px"
                            android:textColor="@color/white"
                            android:layout_marginRight="1dp"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/operationRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:numColumns="3"
                            tools:itemCount="30"
                            tools:listitem="@layout/sewing_operation_item" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/defectListCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp5"
            android:layout_marginRight="@dimen/dp5"
            android:layout_marginTop="@dimen/dp5"
            android:layout_weight="1"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/dp5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/backOperationFromDefectButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#009688"
                            android:padding="@dimen/dp5"
                            android:text="OPERATION LIST"
                            android:drawableLeft="@drawable/ic_arrow_back_white_24px"
                            android:textColor="@color/white"
                            android:layout_marginRight="5dp"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/backOutputFromDefectButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#FF5722"
                            android:padding="@dimen/dp5"
                            android:text="SEWING OUTPUT"
                            android:drawableLeft="@drawable/ic_arrow_back_white_24px"
                            android:textColor="@color/white"
                            android:layout_marginRight="1dp"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/defectRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:verticalSpacing="1dp"
                            tools:itemCount="15"
                            tools:listitem="@layout/sewing_output_pop_up_layout" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/listCard"
            android:layout_alignParentBottom="true"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="@dimen/dp0"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp2"
                android:layout_weight="1"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp5"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/dp5">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/saveBT"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp60"
                        android:background="#4CAF50"
                        android:padding="@dimen/dp20"
                        android:text="SAVE"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp5"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/dp5">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/refreshBT"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp60"
                        android:background="#FF9800"
                        android:padding="@dimen/dp20"
                        android:text="REFRESH"
                        android:textColor="@color/semi_gray"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
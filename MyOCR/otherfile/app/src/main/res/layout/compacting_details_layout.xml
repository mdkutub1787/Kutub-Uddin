<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp5">
        <LinearLayout
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/slTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingRight="@dimen/dp15"
                android:layout_margin="@dimen/dp5"
                android:text="SL"/>
            <CheckBox
                android:id="@+id/selectionCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"/>
            <TextView
                android:id="@+id/cons_compositeTV"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:paddingRight="@dimen/dp15"
                android:layout_margin="@dimen/dp5"
                android:text=""/>
            <TextView
                android:id="@+id/gsmTV"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_margin="@dimen/dp5"
                android:gravity="center"
                android:text=""/>
            <TextView
                android:id="@+id/dia_widthTV"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_margin="@dimen/dp5"
                android:gravity="center"
                android:text=""/>
            <TextView
                android:id="@+id/d_w_widthTV"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_margin="@dimen/dp5"
                android:gravity="center"
                android:text=""/>
            <TextView
                android:id="@+id/roll_noTV"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_margin="@dimen/dp5"
                android:gravity="center"
                android:text=""/>
            <TextView
                android:id="@+id/barcodeTV"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_margin="@dimen/dp5"
                android:gravity="center"
                android:text=""/>
            <TextView
                android:id="@+id/batchQtyTV"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_margin="@dimen/dp5"
                android:gravity="center"
                android:text=""/>
            <TextView
                android:id="@+id/prodQtyTV"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_margin="@dimen/dp5"
                android:gravity="center"
                android:text=""/>
            <TextView
                android:id="@+id/rateTV"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_margin="@dimen/dp5"
                android:gravity="center"
                android:text=""/>
            <TextView
                android:id="@+id/amountTV"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_margin="@dimen/dp5"
                android:gravity="center"
                android:text=""/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.v_1_ui.device_session.V1_ActiveDeviceStatusActivity">
    <androidx.cardview.widget.CardView
        android:id="@+id/rectifiedListCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/dp5"
        app:cardCornerRadius="@dimen/dp5">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="@dimen/dp5"
            android:layout_marginRight="@dimen/dp5">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp10"
                    android:visibility="visible"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/dp0"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="3dp"
                        android:layout_marginTop="2dp"
                        app:cardBackgroundColor="@color/card_color"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="2dp">
                        <TextView
                            android:id="@+id/userNameTV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="User Name"
                            android:textSize="14sp"
                            android:padding="5dp"
                            android:textStyle="bold"
                            android:textColor="#2C2B2B"
                            android:gravity="center|left"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/dp0"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="3dp"
                        android:layout_marginTop="2dp"
                        app:cardBackgroundColor="@color/card_color"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="2dp">
                        <TextView
                            android:id="@+id/deviceIDTV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Device Id"
                            android:textSize="14sp"
                            android:padding="5dp"
                            android:textStyle="bold"
                            android:textColor="#2C2B2B"
                            android:gravity="center|left"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/dp0"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="3dp"
                        android:layout_marginTop="2dp"
                        app:cardBackgroundColor="@color/card_color"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="2dp">
                        <TextView
                            android:id="@+id/floorNameTV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Floor Name"
                            android:textSize="14sp"
                            android:padding="5dp"
                            android:textStyle="bold"
                            android:textColor="#2C2B2B"
                            android:gravity="center|left"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/dp0"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="3dp"
                        android:layout_marginTop="2dp"
                        app:cardBackgroundColor="@color/card_color"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="2dp">
                        <TextView
                            android:id="@+id/lineNameTV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Line Name"
                            android:textSize="14sp"
                            android:padding="5dp"
                            android:textStyle="bold"
                            android:textColor="#2C2B2B"
                            android:gravity="center|left"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/dp0"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="3dp"
                        android:layout_marginTop="2dp"
                        app:cardBackgroundColor="@color/card_color"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="2dp">
                        <TextView
                            android:id="@+id/jobNoTV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Job No"
                            android:textSize="14sp"
                            android:padding="5dp"
                            android:textStyle="bold"
                            android:textColor="#2C2B2B"
                            android:gravity="center|left"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/dp0"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="3dp"
                        android:layout_marginTop="2dp"
                        app:cardBackgroundColor="@color/card_color"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="2dp">
                        <TextView
                            android:id="@+id/itemNameTV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Internal Ref"
                            android:textSize="14sp"
                            android:padding="5dp"
                            android:textStyle="bold"
                            android:textColor="#2C2B2B"
                            android:gravity="center|left"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/dp0"
                        android:layout_height="55dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="2dp"
                        app:cardBackgroundColor="@color/card_color"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/removeBtn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Action"
                            android:textSize="14sp"
                            android:textColor="#F44336"
                            android:textStyle="bold"
                            android:gravity="center|center"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/activeDeviceStatusRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginRight="5dp"
                    android:layout_marginLeft="5dp"
                    android:listSelector="#02fff6"
                    android:numColumns="1"
                    tools:itemCount="4"
                    android:dividerHeight="5.0sp"
                    android:verticalSpacing="1dp"
                    tools:listitem="@layout/active_device_item"/>
            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
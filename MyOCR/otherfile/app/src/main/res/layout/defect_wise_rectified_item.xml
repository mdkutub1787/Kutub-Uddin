<LinearLayout xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayoutSewingIn"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="MissingDefaultResource">
    <LinearLayout
        android:id="@+id/ly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp1"
        android:orientation="horizontal">
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:gravity="center|center"
            android:layout_gravity="center|center">
            <RadioButton
                android:id="@+id/checkBox"
                android:layout_width="@dimen/dp60"
                android:layout_height="match_parent"
                android:padding="5dp"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center|center"
                android:theme="@style/MyRadioButton"
                android:button="@drawable/radio_button"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/operationNameTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Operation"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1.2"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/defectNameTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Defect Name"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight=".8"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/defectTypeTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Defect Type"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/colorTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Color"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1"
            app:cardCornerRadius="3dp"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/sizeTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Size"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|left"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1"
            app:cardCornerRadius="3dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/sysChallanTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Defect Name"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|center"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1"
            app:cardCornerRadius="3dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/dtlsIDTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Defect Name"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|center"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1"
            app:cardCornerRadius="3dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/alterQuantityTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Defect Name"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|center"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1"
            app:cardCornerRadius="3dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/spotQuantityTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Defect Name"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|center"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp60"
            android:layout_weight="1"
            app:cardCornerRadius="3dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_color"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="2dp">
            <TextView
                android:id="@+id/productionDateTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Defect Name"
                android:textSize="20sp"
                android:padding="5dp"
                android:textColor="#2C2B2B"
                android:gravity="center|center"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
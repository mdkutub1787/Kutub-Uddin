<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/back_img"
    tools:context=".ui.v_1_ui.with_observation_qc.V1_FinishFabricObsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="10">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="7"
                android:orientation="horizontal"
                android:weightSum="3">
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight=".60"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="5dp"
                    app:cardCornerRadius="5dp">
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#ffffff"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="2dp"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_marginTop="2dp"
                                    android:orientation="vertical">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">
                                        <com.google.android.material.textfield.TextInputLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">
                                            <androidx.appcompat.widget.AppCompatButton
                                                android:id="@+id/TVDate"
                                                android:layout_width="fill_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="16dp"
                                                android:background="@drawable/textviewshape"
                                                android:drawableTint="#FF4081"
                                                android:gravity="center"
                                                android:singleLine="true"
                                                android:hint="Date"
                                                android:textSize="20sp"
                                                android:textStyle="bold" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <com.google.android.material.textfield.TextInputEditText
                                                android:id="@+id/qcName"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="text"
                                                android:hint="QC Name" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <com.google.android.material.textfield.TextInputEditText
                                                android:id="@+id/actualDia"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="numberDecimal"
                                                android:hint="Actual Dia" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <com.google.android.material.textfield.TextInputEditText
                                                android:id="@+id/actualGsm"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="numberDecimal"
                                                android:hint="Actual GSM" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <com.google.android.material.textfield.TextInputEditText
                                                android:id="@+id/roll_weight_kg"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="numberDecimal"
                                                android:hint="Roll Wt.(Kg)" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <TextView
                                                android:id="@+id/roll_weight_yards"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:background="@drawable/textviewshape"
                                                android:padding="@dimen/dp5"
                                                android:textColor="#000000"
                                                android:hint="Roll Wt.(Yds)"
                                                android:singleLine="true"/>
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <com.google.android.material.textfield.TextInputEditText
                                                android:id="@+id/reject_qty"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="numberDecimal"
                                                android:hint="Reject Qty." />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <TextView
                                                android:id="@+id/gsm"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:background="@drawable/textviewshape"
                                                android:padding="@dimen/dp5"
                                                android:textColor="#000000"
                                                android:hint="GSM"
                                                android:singleLine="true"/>
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <TextView
                                                android:id="@+id/dia"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:background="@drawable/textviewshape"
                                                android:padding="@dimen/dp5"
                                                android:textColor="#000000"
                                                android:hint="DIA"
                                                android:singleLine="true"/>
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <TextView
                                                android:id="@+id/febdes"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:background="@drawable/textviewshape"
                                                android:padding="@dimen/dp5"
                                                android:textColor="#000000"
                                                android:hint="Fab. Des"
                                                android:singleLine="true"/>
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <com.google.android.material.textfield.TextInputEditText
                                                android:id="@+id/tablemc"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="text"
                                                android:hint="Table/M/C No" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <TextView
                                                android:id="@+id/shrinkage"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:background="@drawable/textviewshape"
                                                android:padding="@dimen/dp5"
                                                android:textColor="#000000"
                                                android:hint="Shrinkage %"
                                                android:singleLine="true"/>
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <com.google.android.material.textfield.TextInputEditText
                                                android:id="@+id/length"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="numberDecimal"
                                                android:hint="Length(%)" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <com.google.android.material.textfield.TextInputEditText
                                                android:id="@+id/width"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="numberDecimal"
                                                android:hint="Width(%)" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_marginLeft="3dp">

                                            <com.google.android.material.textfield.TextInputEditText
                                                android:id="@+id/twisting"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="numberDecimal"
                                                android:hint="Twisting %" />
                                        </com.google.android.material.textfield.TextInputLayout>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:id="@+id/linearGrid"
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_weight="2.40"
                    android:weightSum="10"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <GridView
                            android:id="@+id/gridViewInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:layout_marginTop="5dp"
                            android:listSelector="#02fff6"
                            android:numColumns="1"
                            android:verticalSpacing="1dp" />
                        <GridView
                            android:id="@+id/obs_gridViewInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:layout_marginTop="5dp"
                            android:listSelector="#02fff6"
                            android:numColumns="1"
                            android:visibility="gone"
                            android:verticalSpacing="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:layout_marginTop="2dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="2dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.6"
                        android:background="#fff"
                        android:orientation="vertical">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="3dp"
                            android:layout_marginLeft="3dp">

                            <TextView
                                android:id="@+id/system_id"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#1E8DBF"
                                android:padding="@dimen/dp5"
                                android:textColor="#FFFFFF"
                                android:hint="System Id"
                                android:singleLine="true"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="3dp"
                            android:layout_marginLeft="3dp">

                            <TextView
                                android:id="@+id/batchNo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#1E8DBF"
                                android:padding="@dimen/dp5"
                                android:textColor="#FFFFFF"
                                android:hint="Batch No"
                                android:singleLine="true"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="3dp"
                            android:layout_marginLeft="3dp">

                            <TextView
                                android:id="@+id/buyer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#1E8DBF"
                                android:padding="@dimen/dp5"
                                android:textColor="#FFFFFF"
                                android:hint="Buyer"
                                android:singleLine="true"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="3dp"
                            android:layout_marginLeft="3dp">

                            <TextView
                                android:id="@+id/fbno"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#1E8DBF"
                                android:padding="@dimen/dp5"
                                android:textColor="#FFFFFF"
                                android:hint="FB NO"
                                android:singleLine="true"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="3dp"
                            android:layout_marginLeft="3dp">

                            <TextView
                                android:id="@+id/rollNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#1E8DBF"
                                android:padding="@dimen/dp5"
                                android:textColor="#FFFFFF"
                                android:hint="Roll Number"
                                android:singleLine="true"/>
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2.40"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginRight="2dp"
                                android:layout_marginLeft="2dp"
                                android:layout_marginTop="2dp">
                                <EditText
                                    android:id="@+id/commentET"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:hint="Comments"
                                    android:background="@drawable/defecttextviewshape"
                                    android:gravity="center"
                                    android:textSize="18sp"
                                    android:singleLine="true"/>
                                <!--                        <android.support.design.widget.TextInputLayout-->
                                <!--                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"-->
                                <!--                            android:layout_width="match_parent"-->
                                <!--                            android:layout_height="match_parent"-->
                                <!--                            android:layout_marginRight="3dp"-->
                                <!--                            android:layout_marginLeft="3dp">-->
                                <!--                            <android.support.design.widget.TextInputEditText-->
                                <!--                                android:id="@+id/commentET"-->
                                <!--                                android:layout_width="match_parent"-->
                                <!--                                android:layout_height="match_parent"-->
                                <!--                                android:background="#ffffff"-->
                                <!--                                android:hint="Comments"-->
                                <!--                                android:textSize="18sp"-->
                                <!--                                android:singleLine="true"/>-->
                                <!--                        </android.support.design.widget.TextInputLayout>-->
                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="2dp"
                                android:layout_marginRight="2dp"
                                android:padding="1dp">
                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/observation_btn"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="16sp"
                                    android:textColor="#000000"
                                    android:gravity="center"
                                    android:background="@drawable/defecttextviewshape" />
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="2dp"
                                android:layout_marginRight="2dp"
                                android:padding="1dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="16sp"
                                    android:textColor="#000000"
                                    android:textAlignment="textEnd"
                                    android:layout_marginRight="30dp"
                                    android:gravity="end|center"
                                    android:text="Total Penalty Point:"/>
                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="2dp"
                                android:layout_marginRight="2dp"
                                android:padding="1dp">
                                <TextView
                                    android:id="@+id/penaltyPointTV"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:inputType="number"
                                    android:editable="false"
                                    android:layout_marginLeft="35dp"
                                    android:textSize="18sp"
                                    android:hint="0.00"
                                    android:textAlignment="textStart"
                                    android:gravity="start|center" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="2dp"
                                android:layout_marginRight="2dp"
                                android:padding="1dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:textSize="16sp"
                                    android:textColor="#000000"
                                    android:textAlignment="textEnd"
                                    android:layout_marginRight="30dp"
                                    android:gravity="end|center"
                                    android:text="Total Point:"/>
                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="2dp"
                                android:layout_marginRight="2dp"
                                android:padding="1dp">
                                <TextView
                                    android:id="@+id/toalPointTV"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:inputType="number"
                                    android:textSize="16sp"
                                    android:layout_marginLeft="35dp"
                                    android:editable="false"
                                    android:textAlignment="textStart"
                                    android:gravity="start|center" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="2dp"
                                android:layout_marginRight="2dp"
                                android:padding="1dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:textSize="16sp"
                                    android:textColor="#000000"
                                    android:textAlignment="textEnd"
                                    android:layout_marginRight="30dp"
                                    android:gravity="end|center"
                                    android:text="Fabric Grade:"/>
                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginLeft="2dp"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="2dp"
                                android:layout_marginRight="2dp"
                                android:padding="1dp">
                                <TextView
                                    android:id="@+id/febricGradeTV"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:textSize="18sp"
                                    android:editable="false"
                                    android:layout_marginLeft="35dp"
                                    android:textAlignment="textStart"
                                    android:gravity="start|center" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/linear"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_margin="5dp"
                            android:layout_below="@id/linearGrid"
                            android:orientation="horizontal"
                            tools:ignore="NotSibling">
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnSave"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="5dp"
                                android:layout_weight="1"
                                android:layout_marginBottom="2dp"
                                android:background="@drawable/button_shape"
                                android:text="Save"
                                android:textColor="#ffffff"
                                android:textSize="20sp" />
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnTryAgain"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="5dp"
                                android:layout_weight="1"
                                android:layout_marginBottom="2dp"
                                android:background="@drawable/button_shape"
                                android:text="TRY AGAIN"
                                android:textColor="#ffffff"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:visibility="gone"
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:background="@drawable/progressbar"
        android:layout_centerVertical="true" />
</LinearLayout>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="65dp"
            android:paddingLeft="@dimen/dp5"
            android:paddingRight="@dimen/dp5"
            android:paddingTop="30dp">
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="horizontal">


    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/button_up_hour"
            android:layout_width="@dimen/dp100"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_keyboard_arrow_up_black_24dp"
            android:layout_alignParentTop="true"/>
        <EditText
            android:id="@+id/edit_text_hour"
            android:layout_width="97dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/button_up_hour"
            android:background="@drawable/bottom_border_shadow"
            android:textAlignment="center"
            android:inputType="number"
            android:maxLength="2"
            />
        <ImageButton
            android:id="@+id/button_down_hour"
            android:layout_width="@dimen/dp100"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_keyboard_arrow_down_black_24dp"
            android:layout_below="@+id/edit_text_hour"
           />
        
    </RelativeLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text=":"/>
    <RelativeLayout
        android:id="@+id/layout_minute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/button_up_minute"
            android:layout_width="@dimen/dp100"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_keyboard_arrow_up_black_24dp"
            android:layout_alignParentTop="true"/>
        <EditText
            android:id="@+id/edit_text_minute"
            android:layout_width="97dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/button_up_minute"
            android:textAlignment="center"
            android:background="@drawable/bottom_border_shadow"
            android:inputType="number"
            android:maxLength="2"
            />
        <ImageButton
            android:id="@+id/button_down_minute"
            android:layout_width="@dimen/dp100"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_keyboard_arrow_down_black_24dp"
            android:layout_below="@+id/edit_text_minute"
            />

    </RelativeLayout>
</LinearLayout>
    <RelativeLayout

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btn_later"
            style="@style/Button.Action.Negative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/btn_submit"
            style="@style/Button.Action.Positive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="@string/submit" />
    </RelativeLayout>
</LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>

<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp5"
        android:layout_marginBottom="@dimen/dp3"
        app:cardBackgroundColor="@color/ballReleaseColor">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/dp5"
            android:layout_margin="@dimen/dp1"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:id="@+id/ly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/white"
                android:layout_margin="@dimen/dp2">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp2"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_marginBottom="@dimen/dp5"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dp5"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="right"
                                android:textColor="@color/dashboard_orange"
                                android:textStyle="bold" />
                            <androidx.cardview.widget.CardView
                                android:layout_width="80dp"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom"
                                app:cardCornerRadius="@dimen/dp5">
                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/endBT"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp40"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:layout_gravity="center"
                                    android:text="END"
                                    android:background="@color/green_700"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/countingTV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:textColor="@color/dashboard_orange"
                                android:textStyle="bold" />
                            <androidx.cardview.widget.CardView
                                android:layout_width="80dp"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom"
                                app:cardCornerRadius="@dimen/dp5">
                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/cancleBT"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp40"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:layout_gravity="center"
                                    android:text="CANCEL"
                                    android:background="@color/red"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp5">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="@dimen/dp40"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="SL"
                                        android:textColor="@color/dashboard_text_light"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:id="@+id/slTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center"
                                        android:textColor="#000"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="100"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Emp Id"/>
                                    <TextView
                                        android:id="@+id/empIdTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Bundle No"/>
                                    <TextView
                                        android:id="@+id/bundleIdTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="BHG-09876"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Operation"/>
                                    <TextView
                                        android:id="@+id/operationTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="Sleeve Join"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="50dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Qty"/>
                                    <TextView
                                        android:id="@+id/qtyTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="500"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Color"/>
                                    <TextView
                                        android:id="@+id/colorTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="Green"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="50dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Size"/>
                                    <TextView
                                        android:id="@+id/sizeTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="M"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Job No"/>
                                    <TextView
                                        android:id="@+id/jobNoTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Buyer"/>
                                    <TextView
                                        android:id="@+id/buyerTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="PO Number"/>
                                    <TextView
                                        android:id="@+id/poNumberTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Country"/>
                                    <TextView
                                        android:id="@+id/countryTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Gmts. Item"/>
                                    <TextView
                                        android:id="@+id/gmtsTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
</LinearLayout>
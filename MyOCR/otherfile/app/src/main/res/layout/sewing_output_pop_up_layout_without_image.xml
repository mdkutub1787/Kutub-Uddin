<RelativeLayout xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayoutSewingIn"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginRight="2dp"
    android:layout_marginLeft="2dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="MissingDefaultResource">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/dp45"
                    android:layout_height="@dimen/dp45"
                    app:cardCornerRadius="3dp"
                    android:layout_marginBottom="1dp"
                    app:cardBackgroundColor="@color/card_color"

                    android:layout_marginTop="2dp"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp">
                    <TextView
                        android:id="@+id/slTV"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="SL"
                        android:padding="@dimen/dp10"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp45"
                    app:cardCornerRadius="3dp"
                    android:layout_marginBottom="1dp"
                    app:cardBackgroundColor="@color/card_color"
                    android:layout_marginTop="2dp"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp">
                    <TextView
                        android:id="@+id/defectNameTV"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="10sp"
                        android:padding="@dimen/dp10"
                        android:text="18990000004170"
                        android:layout_gravity="center"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="@dimen/dp45"
                android:layout_weight=".3"
                app:cardCornerRadius="3dp"
                android:layout_marginBottom="1dp"
                app:cardBackgroundColor="@color/bg_color"
                android:layout_marginTop="2dp"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="visible"
                        android:background="@drawable/edit_border"
                        android:layout_marginBottom="1dp"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="1dp">
                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/defectUp"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/ic_keyboard_arrow_up_black_24dp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/defectCountET"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginBottom="1dp"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="1dp"
                        android:editable="false"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:background="@drawable/edit_border"
                        android:inputType="number"
                        android:layout_gravity="center"
                        android:gravity="center"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="visible"
                        android:background="@drawable/edit_border"
                        android:layout_marginBottom="1dp"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="1dp">
                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/defectDown"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/ic_keyboard_arrow_down_black_24dp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".7"
                android:visibility="gone"
                android:layout_marginBottom="1dp"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp"
                android:orientation="vertical">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp45"
                    app:cardCornerRadius="3dp"
                    android:layout_marginBottom="1dp"
                    app:cardBackgroundColor="@color/card_color"
                    android:layout_marginTop="2dp"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp">
                    <ImageView
                        android:id="@+id/selectImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:textSize="14sp"
                        android:src="@drawable/ic_baseline_touch_app_24"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
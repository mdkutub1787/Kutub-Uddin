<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="65dp"
                android:paddingLeft="@dimen/dp5"
                android:paddingRight="@dimen/dp5"
                android:paddingTop="30dp">


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bottom_border_shadow"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/text_view_1"
                        style="@style/TextStyle.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:text="@string/barcode_no" />
                    <TextView
                        android:id="@+id/text_view_2"
                        style="@style/TextStyle.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:text="17" />
                </RelativeLayout>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dp10">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                        <RelativeLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/dp5"
                            android:paddingBottom="@dimen/dp10"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/text_batch_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"

                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color"
                                android:text=""/>


                            <TextView
                                android:layout_alignParentRight="true"
                                android:id="@+id/text_roll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="" />

                        </RelativeLayout>
                        <TextView
                            android:id="@+id/text_color_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:paddingLeft="@dimen/dp5"
                            android:paddingBottom="@dimen/dp10"
                            android:textSize="@dimen/dp13"
                            android:textColor="@color/list_header_title_text_color"
                            android:text=""/>
                        <TextView
                            android:id="@+id/text_body_part_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:paddingLeft="@dimen/dp5"
                            android:paddingBottom="@dimen/dp10"
                            android:textSize="@dimen/dp13"
                            android:textColor="@color/list_header_title_text_color"
                            android:text=""/>
                        <RelativeLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/dp5"
                            android:paddingBottom="@dimen/dp10"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/text_file_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"

                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color"
                                android:text=""/>


                            <TextView
                                android:layout_alignParentRight="true"
                                android:id="@+id/text_ref"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="" />

                        </RelativeLayout>
                        <View
                            android:background="#B3ABAB"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/dp5"
                            android:paddingBottom="@dimen/dp10"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".4"

                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color"
                                android:text="MACHINE"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".1"

                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_value_text_color"
                                android:text=":"/>

                            <Spinner
                                android:id="@+id/spinner_machine"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight=".5" />

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/dp5"
                            android:paddingBottom="@dimen/dp10"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".4"

                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color"
                                android:text="SHIFT"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".1"

                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_value_text_color"
                                android:text=":"/>

                            <Spinner
                                android:id="@+id/spinner_shift"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight=".5" />

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/dp5"
                            android:paddingBottom="@dimen/dp10"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".4"

                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color"
                                android:text="Shade"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".1"

                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_value_text_color"
                                android:text=":"/>

                            <Spinner
                                android:id="@+id/spinner_shade"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight=".5" />

                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/text_layout_actual_dia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/edit_text_actual_dia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:hint="@string/actual_dia"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/text_layout_actual_gsm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/edit_text_actual_gsm"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:hint="@string/actual_gsm"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/text_layout_roll_width_inch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/edit_text_roll_width_inch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:hint="@string/roll_width_inch"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/text_layout_lengthYds"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/edit_text_lengthYds"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:enabled="false"
                                android:hint="@string/length_yds"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/text_layout_qc_qty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/edit_text_qc_qty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/qc_quantity"
                                android:inputType="numberDecimal"
                                />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/text_layout_reject"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/edit_text_reject"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/reject"
                                android:inputType="numberDecimal"
                                />
                        </com.google.android.material.textfield.TextInputLayout>



                    </LinearLayout>


                </RelativeLayout>

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btn_later"
                    style="@style/Button.Action.Negative"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:text="@string/cancel" />

                <Button
                    android:id="@+id/btn_submit"
                    style="@style/Button.Action.Positive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:text="@string/submit" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>

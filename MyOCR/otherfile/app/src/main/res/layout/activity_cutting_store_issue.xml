<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.v_1_ui.cutting.V1_CuttingStoreIssueActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp5"
                    android:layout_marginRight="@dimen/dp5"
                    app:cardCornerRadius="@dimen/dp5">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/border_black"
                        android:orientation="vertical"
                        android:padding="@dimen/dp5">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="horizontal">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginTop="@dimen/dp5"
                                    app:cardCornerRadius="@dimen/dp5">
                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/bundleScanBT"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp65"
                                        android:textColor="@color/basePressColor"
                                        android:drawableRight="@drawable/ic_baseline_qr_code_scanner_24"
                                        android:text="@string/bundle_scan"
                                        android:background="#324F5C"
                                        android:textSize="16sp"
                                        android:padding="@dimen/dp20"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp2"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/bundleScanTV"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:textColor="@color/red_color_picker"
                                android:text=""
                                android:padding="@dimen/dp2"
                                android:background="@drawable/edit_border"
                                android:textSize="14sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="@dimen/dp0"
                                android:layout_height="match_parent"
                                android:layout_marginRight="@dimen/dp2"
                                android:layout_weight="1"
                                android:orientation="horizontal">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/dp2"
                                    android:layout_marginRight="@dimen/dp2"
                                    android:layout_marginBottom="@dimen/dp5"
                                    app:cardCornerRadius="@dimen/dp5">
                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/addBT"
                                        android:textStyle="bold"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp60"
                                        android:textColor="@color/white"
                                        android:textSize="16sp"
                                        android:text="Add +"
                                        android:background="#2196F3"
                                        android:padding="@dimen/dp20"/>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/cuttingStoreRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:itemCount="10"
                            tools:listitem="@layout/cutting_store_receive_layout" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="@dimen/dp0"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp2"
            android:layout_weight="1"
            android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/dp5"
                app:cardCornerRadius="@dimen/dp5">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/saveBT"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp60"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:text="SAVE"
                    android:background="#4CAF50"
                    android:padding="@dimen/dp20"/>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/dp5"
                app:cardCornerRadius="@dimen/dp5">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/refreshBT"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp60"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:text="RESET"
                    android:background="#FF5722"
                    android:padding="@dimen/dp20"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
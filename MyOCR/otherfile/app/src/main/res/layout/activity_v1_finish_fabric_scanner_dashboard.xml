<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.v_1_ui.without_observation_qc.V1_FinishFabricScannerDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:gravity="center">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/barcodeScanBTN"
            android:layout_width="250dp"
            android:layout_height="150dp"
            android:background="#324F5C"
            android:drawableEnd="@drawable/ic_baseline_qr_code_scanner_24_1"
            android:padding="@dimen/dp5"
            android:text="Barcode Scan"
            android:textColor="@color/basePressColor"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:layout_marginBottom="@dimen/dp10"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/batchScanBTN"
            android:layout_width="250dp"
            android:layout_height="150dp"
            android:background="#324F5C"
            android:drawableEnd="@drawable/ic_baseline_qr_code_scanner_24_1"
            android:padding="@dimen/dp5"
            android:text="Batch Scan"
            android:textColor="@color/basePressColor"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</RelativeLayout>
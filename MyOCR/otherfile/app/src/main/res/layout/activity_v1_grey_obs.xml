<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/back_img"
    tools:context=".ui.v_1_ui.with_observation_qc.V1_GreyObsActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="10">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="7"
                android:orientation="horizontal"
                android:weightSum="3">
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight=".60"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginTop="5dp"
                    app:cardCornerRadius="5dp">
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#ffffff"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_marginLeft="3dp">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/barcodeET"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:hint="Bar code"
                                        android:singleLine="true"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_marginLeft="3dp">

                                    <TextView
                                        android:id="@+id/rollnumberEt"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:background="@drawable/textviewshape"
                                        android:text="20sp"
                                        android:padding="@dimen/dp5"
                                        android:textColor="#000000"
                                        android:hint="Roll Number"
                                        android:singleLine="true"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_marginLeft="3dp">
                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/datepicker"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="16dp"
                                        android:background="@drawable/textviewshape"
                                        android:drawableTint="#FF4081"
                                        android:gravity="center"
                                        android:singleLine="true"
                                        android:text="Date"
                                        android:textSize="20sp"
                                        android:textStyle="bold" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/userIDTextInputLayout"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_marginLeft="3dp">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/qcnameET"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:hint="QC name" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_marginLeft="3dp">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/roll_Width_incET"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:hint="Rol Width Inch" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_marginLeft="3dp">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/roll_width_KgET"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:editable="false"
                                        android:hint="Roll Wgt.(Kg)"
                                        android:singleLine="true"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_marginLeft="3dp">
                                    <TextView
                                        android:id="@+id/roll_lengthET"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="16dp"
                                        android:drawableTint="#FF4081"
                                        android:gravity="start"
                                        android:inputType="number"
                                        android:background="@drawable/textviewshape"
                                        android:padding="@dimen/dp5"
                                        android:textColor="#000000"
                                        android:textSize="18sp"
                                        android:hint="Roll Length(Yds)"
                                        android:singleLine="true" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_marginLeft="3dp">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/rejectET"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="numberDecimal"
                                        android:hint="Reject Qty(Kg)"
                                        android:text="0.0"
                                        android:singleLine="true"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_marginRight="2dp"
                                    android:padding="1dp">
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginRight="3dp"
                                        android:layout_marginLeft="3dp">
                                        <TextView
                                            android:id="@+id/constructionTV"
                                            android:layout_width="fill_parent"
                                            android:layout_height="match_parent"
                                            android:layout_marginTop="16dp"
                                            android:drawableTint="#FF4081"
                                            android:gravity="start"
                                            android:textColor="#000000"
                                            android:background="@drawable/textviewshape"
                                            android:padding="@dimen/dp5"
                                            android:textSize="21sp"
                                            android:hint="Construction and Composition"
                                            android:singleLine="true" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:padding="1dp">
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginRight="3dp"
                                        android:layout_marginLeft="3dp">
                                        <TextView
                                            android:id="@+id/gsmTV"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="16dp"
                                            android:drawableTint="#FF4081"
                                            android:gravity="start"
                                            android:textColor="#000000"
                                            android:textSize="18sp"
                                            android:background="@drawable/textviewshape"
                                            android:padding="@dimen/dp5"
                                            android:hint="GSM"
                                            android:singleLine="true" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:padding="1dp">
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginRight="3dp"
                                        android:layout_marginLeft="3dp">
                                        <TextView
                                            android:id="@+id/diaTV"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="16dp"
                                            android:drawableTint="#FF4081"
                                            android:gravity="start"
                                            android:textColor="#000000"
                                            android:textSize="16sp"
                                            android:background="@drawable/textviewshape"
                                            android:padding="@dimen/dp5"
                                            android:hint="Dia"
                                            android:singleLine="true" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:padding="1dp">
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginRight="3dp"
                                        android:layout_marginLeft="3dp">
                                        <TextView
                                            android:id="@+id/mcDiaTV"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="16dp"
                                            android:drawableTint="#FF4081"
                                            android:gravity="start"
                                            android:textColor="#000000"
                                            android:background="@drawable/textviewshape"
                                            android:padding="@dimen/dp5"
                                            android:textSize="18sp"
                                            android:hint="M/C Dia"
                                            android:singleLine="true" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:padding="1dp">
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginRight="3dp"
                                        android:layout_marginLeft="3dp">
                                        <TextView
                                            android:id="@+id/colorTV"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="16dp"
                                            android:drawableTint="#FF4081"
                                            android:gravity="start"
                                            android:textColor="#000000"
                                            android:textSize="18sp"
                                            android:background="@drawable/textviewshape"
                                            android:padding="@dimen/dp5"
                                            android:hint="Color"
                                            android:singleLine="true" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:padding="1dp">
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginRight="3dp"
                                        android:layout_marginLeft="3dp">
                                        <TextView
                                            android:id="@+id/yarn_countTV"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="16dp"
                                            android:drawableTint="#FF4081"
                                            android:gravity="start"
                                            android:textColor="#000000"
                                            android:background="@drawable/textviewshape"
                                            android:padding="@dimen/dp5"
                                            android:textSize="18sp"
                                            android:hint="Yarn Count"
                                            android:singleLine="true" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:padding="1dp">
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginRight="3dp"
                                        android:layout_marginLeft="3dp">
                                        <TextView
                                            android:id="@+id/yarnLotTV"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="16dp"
                                            android:drawableTint="#FF4081"
                                            android:gravity="start"
                                            android:textColor="#000000"
                                            android:background="@drawable/textviewshape"
                                            android:padding="@dimen/dp5"
                                            android:textSize="18sp"
                                            android:hint="Yarn Lot"
                                            android:singleLine="true" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:padding="1dp">
                                    <com.google.android.material.textfield.TextInputLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginRight="3dp"
                                        android:layout_marginLeft="3dp">
                                        <TextView
                                            android:id="@+id/spinningTV"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="20dp"
                                            android:layout_marginTop="16dp"
                                            android:drawableTint="#FF4081"
                                            android:background="@drawable/textviewshape"
                                            android:padding="@dimen/dp5"
                                            android:gravity="start"
                                            android:textColor="#000000"
                                            android:textSize="18sp"
                                            android:hint="Spinning Mill"
                                            android:singleLine="true" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </androidx.cardview.widget.CardView>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"
                                    android:background="@drawable/textviewshape"
                                    android:padding="1dp">
                                    <Spinner
                                        android:id="@+id/spinnerQc"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="10dp"
                                        android:layout_marginTop="16dp"/>
                                </LinearLayout>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:id="@+id/linearGrid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2.40"
                    android:weightSum="10"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <GridView
                            android:id="@+id/gridViewInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:layout_marginTop="5dp"
                            android:listSelector="#02fff6"
                            android:numColumns="1"
                            android:verticalSpacing="1dp" />
                        <GridView
                            android:id="@+id/obs_gridViewInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:layout_marginTop="5dp"
                            android:listSelector="#02fff6"
                            android:numColumns="1"
                            android:visibility="gone"
                            android:verticalSpacing="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:layout_marginTop="2dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="2dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="2dp"
                        android:layout_marginLeft="2dp">
                        <EditText
                            android:id="@+id/commentET"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="Comments"
                            android:background="@drawable/defecttextviewshape"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:maxLines="1"
                            android:inputType="text"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginRight="2dp"
                        android:padding="1dp">
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/observation_btn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:gravity="center"
                            android:background="@drawable/defecttextviewshape"
                            android:text="Show Result 2"/>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginRight="2dp"
                        android:padding="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:textAlignment="textEnd"
                            android:layout_marginRight="30dp"
                            android:gravity="end|center"
                            android:text="Total Penalty Point:"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginRight="2dp"
                        android:padding="1dp">
                        <TextView
                            android:id="@+id/penaltyPointTV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:inputType="number"
                            android:editable="false"
                            android:layout_marginLeft="35dp"
                            android:textSize="18sp"
                            android:hint="0.00"
                            android:textAlignment="textStart"
                            android:gravity="start|center" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginRight="2dp"
                        android:padding="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:textAlignment="textEnd"
                            android:layout_marginRight="30dp"
                            android:gravity="end|center"
                            android:text="Total Point:"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginRight="2dp"
                        android:padding="1dp">
                        <TextView
                            android:id="@+id/toalPointTV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:inputType="number"
                            android:textSize="16sp"
                            android:layout_marginLeft="35dp"
                            android:editable="false"
                            android:textAlignment="textStart"
                            android:gravity="start|center" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginRight="2dp"
                        android:padding="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:textAlignment="textEnd"
                            android:layout_marginRight="30dp"
                            android:gravity="end|center"
                            android:text="Fabric Grade:"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginRight="2dp"
                        android:padding="1dp">
                        <TextView
                            android:id="@+id/febricGradeTV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:textSize="18sp"
                            android:editable="false"
                            android:layout_marginLeft="35dp"
                            android:textAlignment="textStart"
                            android:gravity="start|center" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/linear"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:layout_below="@id/linearGrid"
                    android:orientation="horizontal"
                    tools:ignore="NotSibling">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/button_shape"
                        android:text="Save"
                        android:textColor="#ffffff"
                        android:textSize="20sp" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTryAgain"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/button_shape"
                        android:text="TRY AGAIN"
                        android:textColor="#ffffff"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar
        android:visibility="gone"
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:background="@drawable/progressbar"
        android:layout_centerVertical="true" />
</RelativeLayout>
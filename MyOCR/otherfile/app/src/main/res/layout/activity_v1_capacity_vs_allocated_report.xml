<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.v_1_ui.report.V1_CapacityVsAllocatedReportActivity">

    <LinearLayout
        android:id="@+id/header_plan_vs_booked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                app:cardCornerRadius="5dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Company"
                        android:gravity="center"
                        android:textColor="@drawable/textColor"
                        android:textSize="18sp" />
                    <Spinner
                        android:id="@+id/companySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                app:cardCornerRadius="5dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:gravity="center"
                        android:textColor="@drawable/textColor"
                        android:textSize="18sp" />
                    <Spinner
                        android:id="@+id/locationSpinnner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                app:cardCornerRadius="5dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Start Date"
                        android:gravity="center"
                        android:textColor="@drawable/textColor"
                        android:textSize="18sp" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/startDateBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:background="@null"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                app:cardCornerRadius="5dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="End Date"
                        android:gravity="center"
                        android:textColor="@drawable/textColor"
                        android:textSize="18sp" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/endDateBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:background="@null"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                app:cardCornerRadius="5dp"
                app:cardBackgroundColor="#673AB7"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/showButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="SHOW"
                        android:gravity="center"
                        android:textColor="#FFEB3B"
                        android:background="#673AB7"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monthly Capacity vs Allocated"
                android:gravity="center"
                android:textColor="#000"
                android:padding="2dp"
                android:background="#DDD0BF"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="2dp"
                    android:background="#673AB7"
                    android:layout_gravity="center">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="SL"
                        android:textSize="18sp"
                        android:textColor="#FFEB3B"
                        android:gravity="center"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#000"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="2dp"
                    android:background="#DDD0BF"
                    android:layout_gravity="center">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Company"
                        android:textSize="10sp"
                        android:textColor="#009688"
                        android:gravity="center"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#000"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.8"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="2dp"
                    android:background="#DDD0BF"
                    android:layout_gravity="center">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Location"
                        android:textSize="10sp"
                        android:textColor="#009688"
                        android:gravity="center"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#000"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:background="#DDD0BF"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="2dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                app:cardBackgroundColor="#DDD0BF"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:text="Minutes/Month"
                                    android:textColor="#000"
                                    android:layout_gravity="center"
                                    android:gravity="center"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                app:cardBackgroundColor="#DDD0BF"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:id="@+id/monthNameText"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:textColor="#000"
                                    android:layout_gravity="center"
                                    android:gravity="center"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                app:cardBackgroundColor="#DDD0BF"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:text="Total"
                                    android:textColor="#000"
                                    android:layout_gravity="center"
                                    android:gravity="center"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#000"/>
        <GridView
            android:id="@+id/planBookedGridView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"
            android:listSelector="#02fff6"
            android:numColumns="1"
            android:dividerHeight="5.0sp"
            android:verticalSpacing="1dp"
            tools:listitem="@layout/plan_vs_booked_report_layout"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F9FAFA"
            android:padding="2dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="#DDD0BF"
                android:layout_weight="1">
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:background="#DDD0BF"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:id="@+id/bookedText"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:text="Capacity"
                                    android:textColor="#000000"
                                    android:layout_gravity="center"
                                    android:gravity="right|center"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:id="@+id/bookedfirstText"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:textColor="#000000"
                                    android:layout_gravity="center"
                                    android:gravity="center|right"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:id="@+id/bookedTotalText"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:textColor="#000000"
                                    android:layout_gravity="center"
                                    android:gravity="center|right"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:id="@+id/planText"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:text="Allocated"
                                    android:textColor="#000"
                                    android:layout_gravity="center"
                                    android:gravity="center|right"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:id="@+id/planfirstText"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:textColor="#000"
                                    android:layout_gravity="center"
                                    android:gravity="center|right"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:id="@+id/planTotalText"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:textColor="#000"
                                    android:layout_gravity="center"
                                    android:gravity="center|right"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:text="Balance"
                                    android:textColor="#000"
                                    android:layout_gravity="center"
                                    android:gravity="center|right"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:id="@+id/balancefirst"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:textColor="#000"
                                    android:layout_gravity="center"
                                    android:gravity="center|right"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardCornerRadius="3dp"
                                android:layout_marginBottom="1dp"
                                android:layout_marginTop="1dp"
                                android:layout_marginLeft="1dp"
                                android:layout_marginRight="1dp">
                                <TextView
                                    android:id="@+id/balanceTotal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="11sp"
                                    android:textColor="#000"
                                    android:layout_gravity="center"
                                    android:gravity="center|right"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>



</LinearLayout>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp5"
        android:layout_marginBottom="@dimen/dp3"
        app:cardBackgroundColor="@color/ballReleaseColor">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/dp5"
            android:layout_margin="@dimen/dp1"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:id="@+id/ly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/white"
                android:layout_margin="@dimen/dp2">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp2"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/layout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp40"
                        android:orientation="horizontal">
                        <ImageButton
                            android:id="@+id/removeBT"
                            android:layout_width="@dimen/dp30"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:padding="5dp"
                            android:src="@drawable/ic_baseline_remove_circle_outline_24"
                            android:background="@drawable/badge_background"/>
                        <LinearLayout
                            android:layout_width="@dimen/dp150"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/companyNameTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:singleLine="true"
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_gravity="left"
                                android:gravity="center"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@drawable/color_gradient_border_result"/>
                        <LinearLayout
                            android:layout_width="@dimen/dp120"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/storeNameTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_gravity="left"
                                android:gravity="center"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@drawable/color_gradient_border_result"/>
                        <LinearLayout
                            android:layout_width="@dimen/dp90"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/bagNoTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_gravity="left"
                                android:gravity="center"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@drawable/color_gradient_border_result"/>
                        <LinearLayout
                            android:layout_width="@dimen/dp120"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/qrCodeNoTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_gravity="left"
                                android:singleLine="true"
                                android:gravity="center"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@drawable/color_gradient_border_result"/>
                        <LinearLayout
                            android:layout_width="@dimen/dp90"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/noOfRollTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_gravity="left"
                                android:singleLine="true"
                                android:gravity="center"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@drawable/color_gradient_border_result"/>
                        <LinearLayout
                            android:layout_width="@dimen/dp90"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/weightTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_gravity="left"
                                android:singleLine="true"
                                android:gravity="center"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@drawable/color_gradient_border_result"/>
                        <LinearLayout
                            android:layout_width="@dimen/dp90"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/uomTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_gravity="left"
                                android:singleLine="true"
                                android:gravity="center"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@drawable/color_gradient_border_result"/>
                        <LinearLayout
                            android:layout_width="@dimen/dp90"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/roomNameTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_gravity="left"
                                android:singleLine="true"
                                android:gravity="center"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@drawable/color_gradient_border_result"/>
                        <LinearLayout
                            android:layout_width="@dimen/dp90"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/rackNameTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_gravity="left"
                                android:singleLine="true"
                                android:gravity="center"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:background="@drawable/color_gradient_border_result"/>
                        <LinearLayout
                            android:layout_width="@dimen/dp90"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/shelfNameTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_gravity="left"
                                android:singleLine="true"
                                android:gravity="center"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
</LinearLayout>
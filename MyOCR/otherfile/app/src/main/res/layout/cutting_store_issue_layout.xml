<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp5"
        android:layout_marginBottom="@dimen/dp3"
        app:cardBackgroundColor="@color/ballReleaseColor">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/dp5"
            android:layout_margin="@dimen/dp1"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:id="@+id/ly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/white"
                android:layout_margin="@dimen/dp2">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp2"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_marginBottom="@dimen/dp5"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/removeF"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:visibility="visible"
                                android:textColor="@color/dashboard_orange"
                                android:textStyle="bold" />
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom"
                                app:cardCornerRadius="@dimen/dp5">
                                <ImageButton
                                    android:id="@+id/removeBT"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp40"
                                    android:layout_gravity="center"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_baseline_remove_circle_outline_24"
                                    android:background="@color/red"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/moreF"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="right"
                                android:visibility="visible"
                                android:textColor="@color/dashboard_orange"
                                android:textStyle="bold" />
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="@dimen/dp5"
                                app:cardCornerRadius="@dimen/dp5">
                                <ImageButton
                                    android:id="@+id/moreBT"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp40"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:layout_gravity="center"
                                    android:text="More"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_baseline_read_more_24"
                                    android:background="@color/violet_color_picker"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp5">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="@dimen/dp40"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/slF"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="SL"
                                        android:visibility="visible"
                                        android:textColor="@color/dashboard_text_light"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:id="@+id/slTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center"
                                        android:textColor="#000"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="100"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="120dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/bundleNoF"
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Bundle No"/>
                                    <TextView
                                        android:id="@+id/bundleNoTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="120dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:visibility="gone"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/locationF"
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Bundle No"/>
                                    <TextView
                                        android:id="@+id/locationTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="@string/sample_text"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="100dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/qntyPcsF"
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Qnty Pcs"/>
                                    <TextView
                                        android:id="@+id/qntyPcsTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="BHG-09876"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="@dimen/dp90"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/poF"
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="PO"/>
                                    <TextView
                                        android:id="@+id/poTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="BHG-09876"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="@dimen/dp120"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/buyerF"
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Buyer"/>
                                    <TextView
                                        android:id="@+id/buyerTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="500"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="@dimen/dp100"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/floorF"
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Cutting Floor"/>
                                    <TextView
                                        android:id="@+id/floorTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="Green"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="@dimen/dp100"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:visibility="visible"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/colorF"
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Color"/>
                                    <TextView
                                        android:id="@+id/colorTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:visibility="visible"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="M"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="@dimen/dp90"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:visibility="visible"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/sizeF"
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="visible"
                                        android:textColor="@color/dashboard_text_light"
                                        android:text="Size"/>
                                    <TextView
                                        android:id="@+id/sizeTV"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp40"
                                        android:gravity="center|left"
                                        android:paddingLeft="@dimen/dp5"
                                        android:textColor="#000"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/edit_border"
                                        android:text="M"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
</LinearLayout>


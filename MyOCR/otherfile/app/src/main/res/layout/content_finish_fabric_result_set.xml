<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"

    android:focusable="true">


    <RelativeLayout
        android:id="@+id/relative"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1.5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:clickable="true"
            android:focusable="true"
            android:scrollbars="none">

            <RelativeLayout
                android:layout_marginBottom="@dimen/dp20"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                >

                <LinearLayout
                    android:id="@+id/lin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:background="@drawable/border_black"
                        android:layout_width="350dp"
                        android:layout_height="365dp"
                        android:orientation="vertical">
                        <EditText
                            android:layout_marginTop="@dimen/dp5"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp30"
                            android:layout_marginRight="23dp"
                            android:layout_marginLeft="23dp"
                            android:textSize="@dimen/sp20"
                            android:background="@drawable/edit_border"
                            android:focusable="false"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="@color/list_header_title_text_color1"
                            android:text="Fabric Roll Information"/>

                        <LinearLayout
                            android:layout_marginTop="@dimen/dp5"
                            android:layout_marginLeft="@dimen/dp20"
                            android:layout_marginRight="@dimen/dp20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:textAllCaps="false"
                                android:text="Barcode"/>

                            <EditText

                                android:id="@+id/edit_barcode"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:background="@drawable/edit_border"
                                android:paddingLeft="5dp"
                                android:focusable="false"

                                android:textColor="@color/list_header_title_text_color1"
                                />

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="@dimen/dp1"
                            android:layout_marginLeft="@dimen/dp20"
                            android:layout_marginRight="@dimen/dp20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:textAllCaps="false"
                                android:text="Date(*)"/>

                            <EditText
                                android:id="@+id/edit_date"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:background="@drawable/edit_border"
                                android:paddingLeft="5dp"
                                android:focusable="false"

                                android:textColor="@color/list_header_title_text_color1"
                                android:text=""/>

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="@dimen/dp1"
                            android:layout_marginLeft="@dimen/dp20"
                            android:layout_marginRight="@dimen/dp20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:textAllCaps="false"
                                android:text="Qc. Name(*)"/>

                            <EditText
                                android:id="@+id/edit_qc_name"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:background="@drawable/edit_border"
                                android:paddingLeft="5dp"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text=""/>

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="@dimen/dp1"
                            android:layout_marginLeft="@dimen/dp20"
                            android:layout_marginRight="@dimen/dp20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:textAllCaps="false"
                                android:text="Ac. Roll Width (inc)(*)"/>

                            <EditText
                                android:id="@+id/edit_ac_roll_width"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:background="@drawable/edit_border"
                                android:paddingLeft="5dp"
                                android:inputType="number"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text=""/>

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="@dimen/dp1"
                            android:layout_marginLeft="@dimen/dp20"
                            android:layout_marginRight="@dimen/dp20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:textAllCaps="false"
                                android:text="Roll Wgt (kg)"/>

                            <EditText
                                android:focusable="false"
                                android:id="@+id/edit_roll_weight"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:background="@drawable/edit_border"
                                android:paddingLeft="5dp"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text=""/>

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="@dimen/dp1"
                            android:layout_marginLeft="@dimen/dp20"
                            android:layout_marginRight="@dimen/dp20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:textAllCaps="false"
                                android:text="Roll Length (Yds.)"/>

                            <EditText

                                android:id="@+id/edit_roll_length"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:background="@drawable/edit_border"
                                android:paddingLeft="5dp"
                                android:focusable="false"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text=""/>

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="@dimen/dp1"
                            android:layout_marginLeft="@dimen/dp20"
                            android:layout_marginRight="@dimen/dp20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:textAllCaps="false"
                                android:text="Ac. GSM"/>

                            <EditText
                                android:id="@+id/edit_gsm"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:background="@drawable/edit_border"
                                android:paddingLeft="5dp"
                                android:focusable="false"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text=""/>

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="@dimen/dp1"
                            android:layout_marginLeft="@dimen/dp20"
                            android:layout_marginRight="@dimen/dp20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:textAllCaps="false"
                                android:text="Reject Qty"/>

                            <EditText
                                android:inputType="number"
                                android:id="@+id/edit_reject"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:background="@drawable/edit_border"
                                android:paddingLeft="5dp"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text=""/>

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="@dimen/dp1"
                            android:layout_marginLeft="@dimen/dp20"
                            android:layout_marginRight="@dimen/dp20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:textAllCaps="false"
                                android:text="Roll Status"/>

                            <Spinner
                                android:id="@+id/spinner"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:background="@drawable/bg_spinner"

                                android:paddingLeft="5dp" />

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="@dimen/dp1"
                            android:layout_marginLeft="@dimen/dp20"
                            android:layout_marginRight="@dimen/dp20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:textAllCaps="false"
                                android:text="Fabric Shde"/>

                            <Spinner
                                android:id="@+id/spinner_shade"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp25"
                                android:layout_weight="1"
                                android:background="@drawable/bg_spinner"

                                android:paddingLeft="5dp" />

                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout

                        android:layout_marginLeft="@dimen/dp7"
                        android:background="@drawable/border_black"
                        android:layout_width="match_parent"
                        android:layout_height="365dp"
                        android:orientation="vertical">
                        <EditText
                            android:layout_marginTop="@dimen/dp5"
                            android:id="@+id/et_batch_no"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp30"
                            android:layout_marginRight="10dp"
                            android:layout_marginLeft="@dimen/dp10"
                            android:textSize="@dimen/sp20"
                            android:background="@drawable/edit_border"
                            android:focusable="false"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="@color/list_header_title_text_color1"
                            android:text="Defect Count in Fabric"/>
                        <LinearLayout
                            android:weightSum="1"
                            android:layout_marginTop="@dimen/dp10"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp8"
                            android:layout_marginRight="@dimen/dp8"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <EditText
                                android:focusable="false"
                                android:background="@drawable/edit_border"
                                android:layout_width="0dp"
                                android:layout_weight=".2"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text="Acc.Point"/>
                            <EditText
                                android:focusable="false"
                                android:layout_width="0dp"
                                android:layout_weight=".1"
                                android:layout_marginLeft="@dimen/dp10"
                                android:background="@drawable/edit_border"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text="28"/>

                            <EditText
                                android:focusable="false"
                                android:layout_marginLeft="@dimen/dp10"
                                android:background="@drawable/edit_border"
                                android:layout_width="0dp"
                                android:layout_weight=".3"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text="Inspected Point"/>
                            <EditText
                                android:focusable="false"
                                android:id="@+id/edit_inspected_point"
                                android:layout_marginLeft="@dimen/dp10"
                                android:background="@drawable/edit_border"
                                android:layout_width="0dp"
                                android:layout_weight=".1"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text=""/>
                            <EditText
                                android:layout_marginLeft="@dimen/dp10"
                                android:background="@drawable/edit_border"
                                android:layout_width="0dp"
                                android:layout_weight=".2"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text="Fabric Grade"/>
                            <EditText
                                android:focusable="false"
                                android:id="@+id/edit_grade"
                                android:layout_marginLeft="@dimen/dp10"
                                android:background="@drawable/edit_border"
                                android:layout_width="0dp"
                                android:layout_weight=".1"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/list_header_title_text_color1"
                                android:text=""/>

                        </LinearLayout>

                        <LinearLayout
                            android:weightSum="1"
                            android:layout_marginTop="@dimen/dp10"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp8"
                            android:layout_marginRight="@dimen/dp8"
                            android:padding="@dimen/dp3"
                            android:orientation="horizontal">
                            <EditText
                                android:focusable="false"
                                android:background="@drawable/edit_hint"
                                android:layout_width="0dp"
                                android:layout_weight=".1"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:text="SL"/>
                            <EditText

                                android:focusable="false"
                                android:layout_width="0dp"
                                android:layout_weight=".2"
                                android:layout_marginLeft="@dimen/dp10"
                                android:background="@drawable/edit_hint"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:text="Defect Name"/>

                            <EditText
                                android:focusable="false"
                                android:layout_marginLeft="@dimen/dp10"
                                android:background="@drawable/edit_hint"
                                android:layout_width="0dp"
                                android:layout_weight=".2"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:text="Defect Count"/>
                            <EditText
                                android:focusable="false"
                                android:layout_marginLeft="@dimen/dp10"
                                android:background="@drawable/edit_hint"
                                android:layout_width="0dp"
                                android:layout_weight=".3"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textStyle="bold"
                                android:textColor="@color/white"                            android:text="Defect Found (Inch)"/>
                            <EditText
                                android:focusable="false"
                                android:layout_marginLeft="@dimen/dp10"
                                android:background="@drawable/edit_hint"
                                android:layout_width="0dp"
                                android:layout_weight=".2"
                                android:layout_height="@dimen/dp25"
                                android:textAlignment="center"
                                android:textSize="@dimen/dp13"
                                android:textStyle="bold"
                                android:textColor="@color/white"                            android:text="Penalty"/>


                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_marginRight="@dimen/dp10"
                            android:layout_width="match_parent"
                            android:layout_height="155dp">

                            <androidx.core.widget.NestedScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:id="@+id/linear"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">


                                </LinearLayout>
                            </androidx.core.widget.NestedScrollView>
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_marginTop="15dp"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_marginRight="10dp"
                            android:id="@+id/rv_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/item_card"
                            android:scrollIndicators="none"
                            android:clickable="true"
                            />
                    </LinearLayout>

                </LinearLayout>
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lin">

                    <LinearLayout

                        android:layout_width="match_parent"


                        android:layout_height="260dp"

                        android:layout_marginBottom="@dimen/dp10"
                        android:orientation="vertical">
                        <EditText
                            android:layout_marginLeft="5dp"
                            android:id="@+id/edit_comments"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/edit_border"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:paddingLeft="5dp"
                            android:textSize="@dimen/dp13"
                            android:textColor="@color/list_header_title_text_color1"
                            android:hint="Enter Comments"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_defect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/item_card"
                            android:layout_marginTop="@dimen/dp2"
                            android:clickable="true"
                            android:scrollIndicators="none" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>

</RelativeLayout>
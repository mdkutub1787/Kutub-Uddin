<RelativeLayout android:id="@+id/linearLayoutSewingIn"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginRight="2dp"
    android:layout_marginLeft="2dp"
    android:layout_marginBottom="2dp"
    android:layout_marginTop="2dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp5"
        android:layout_marginBottom="@dimen/dp3"
        app:cardBackgroundColor="@color/ash">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp1"
            app:cardCornerRadius="@dimen/dp5">
            <LinearLayout
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp40"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/serialTV"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/dp5"
                    android:textColor="@color/blue_black_light"
                    android:text="10"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/dp30"
                    android:layout_gravity="center"
                    android:background="@drawable/color_gradient_border_result"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".3"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/qrCodeClick"
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp20"
                        android:src="@drawable/ic_baseline_qr_code_2_24_black"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/dp30"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:background="@drawable/color_gradient_border_result"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_gravity="center|left"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/bcodeNoTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="220292922082"
                        android:textSize="14sp"
                        android:textColor="@color/black_effective"
                        android:layout_gravity="left"
                        android:textStyle="normal"
                        android:gravity="center|left"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/dp30"
                    android:layout_gravity="center"
                    android:background="@drawable/color_gradient_border_result"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_gravity="center|left"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/barcodeTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="220292922082"
                        android:textSize="14sp"
                        android:textColor="@color/black_effective"
                        android:layout_gravity="left"
                        android:paddingRight="@dimen/dp5"
                        android:textStyle="normal"
                        android:gravity="center|left"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/dp30"
                    android:layout_gravity="center"
                    android:background="@drawable/color_gradient_border_result"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_gravity="center|left"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/weightTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="23.98"
                        android:textSize="14sp"
                        android:textColor="@color/black_effective"
                        android:layout_gravity="left"
                        android:paddingRight="@dimen/dp5"
                        android:textStyle="normal"
                        android:gravity="center|right"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/dp30"
                    android:layout_gravity="center"
                    android:background="@drawable/color_gradient_border_result"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_gravity="center|left"
                    android:orientation="vertical">
                    <EditText
                        android:id="@+id/prodWeightET"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="23.98"
                        android:textSize="14sp"
                        android:textColor="@color/black_effective"
                        android:background="@drawable/border_black"
                        android:layout_gravity="left"
                        android:inputType="numberDecimal"
                        android:paddingRight="@dimen/dp4"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp4"
                        android:layout_marginBottom="@dimen/dp4"
                        android:textStyle="normal"
                        android:gravity="center|right"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/dp30"
                    android:layout_gravity="center"
                    android:background="@drawable/color_gradient_border_result" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_gravity="center"
                    android:gravity="center|right"
                    android:orientation="horizontal">
                    <CheckBox
                        android:id="@+id/unSelectCheckBox"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".ui.v_1_ui.menu.V1_MenuActivity"
    tools:showIn="@layout/app_bar_menu">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/copyRightLy">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Line Wise Hourly Production"
                    android:textSize="@dimen/sp16"
                    android:layout_gravity="center"
                    android:paddingTop="10dp"
                    android:textStyle="bold"
                    android:textColor="#FF5722"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#02DCF8"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_margin="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current Hour Target"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/currectHourTargetTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-thin"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#000"
                                android:textSize="@dimen/sp20"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#F38B8B"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Day Target"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/dayTargetTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-thin"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#000"
                                android:textSize="@dimen/sp20"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#E6B0A7"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_margin="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="#8BC34A"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Efficiency %"
                                        android:textStyle="bold"
                                        android:textColor="#000"
                                        android:textSize="@dimen/sp10"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:padding="5dp"/>
                                    <TextView
                                        android:id="@+id/efficiencyTV"
                                        android:layout_width="wrap_content"
                                        android:layout_height="fill_parent"
                                        android:layout_gravity="center"
                                        android:layout_weight="1"
                                        android:fontFamily="sans-serif-thin"
                                        android:gravity="center"
                                        android:padding="5dp"
                                        android:text="@string/dash_board_value"
                                        android:textColor="#000"
                                        android:textSize="@dimen/sp15"
                                        android:textStyle="bold" />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Effi.. min %"
                                        android:textStyle="bold"
                                        android:textColor="#000"
                                        android:textSize="@dimen/sp10"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:padding="5dp"/>
                                    <TextView
                                        android:id="@+id/efficiencyMinTV"
                                        android:layout_width="wrap_content"
                                        android:layout_height="fill_parent"
                                        android:layout_gravity="center"
                                        android:layout_weight="1"
                                        android:fontFamily="sans-serif-thin"
                                        android:gravity="center"
                                        android:padding="5dp"
                                        android:text="@string/dash_board_value"
                                        android:textColor="#000"
                                        android:textSize="@dimen/sp15"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#673AB7"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/plannedTV"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textStyle="bold"
                                    android:textColor="#FFEB3B"
                                    android:textSize="@dimen/sp10"
                                    android:gravity="center"
                                    android:layout_gravity="start"
                                    android:padding="5dp"/>
                                <TextView
                                    android:id="@+id/dayTotalQntyTV"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textStyle="bold"
                                    android:textColor="#FFEB3B"
                                    android:textSize="@dimen/sp10"
                                    android:gravity="center"
                                    android:layout_gravity="start"
                                    android:padding="5dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#3F51B5"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current Hour Production"
                                android:textStyle="bold"
                                android:textColor="#fff"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/currectHourProductionTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-thin"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#FF0303"
                                android:textSize="@dimen/sp20"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#99F800"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check Quantity"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/checkedQuantityTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-thin"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#464646"
                                android:textSize="@dimen/sp20"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFC107"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_marginBottom="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Day Production"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/dayProductionTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-thin"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#000"
                                android:textSize="@dimen/sp20"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#4CAF50"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DHU %"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/dhuTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-thin"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#000"
                                android:textSize="@dimen/sp20"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#77A3C6"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_marginLeft="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Variance"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/varianceTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-thin"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#000"
                                android:textSize="@dimen/sp16"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#77A3C6"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_marginLeft="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alter"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/alterTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-thin"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#000"
                                android:textSize="@dimen/sp16"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#77A3C6"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_marginLeft="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Spot"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/spotTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-thin"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#000"
                                android:textSize="@dimen/sp16"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#77A3C6"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_marginLeft="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reject"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/rejectTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-thin"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#000"
                                android:textSize="@dimen/sp16"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#77A3C6"
                        app:cardCornerRadius="10dp"
                        android:outlineAmbientShadowColor="#3A3939"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:textSize="@dimen/sp10"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:padding="5dp"/>

                            <TextView
                                android:id="@+id/totalTV"
                                android:layout_width="wrap_content"
                                android:layout_height="fill_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/dash_board_value"
                                android:textColor="#000"
                                android:textSize="@dimen/sp16"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/companyNameTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Company Name:"
                        android:padding="5dp"
                        android:background="#02ABC1"
                        android:textStyle="bold"
                        android:textSize="@dimen/sp10"/>
                    <TextView
                        android:id="@+id/locationTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Location:"
                        android:padding="5dp"
                        android:background="#33CBDF"
                        android:textStyle="bold"
                        android:textSize="@dimen/sp10"/>
                    <TextView
                        android:id="@+id/floorTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Floor:"
                        android:padding="5dp"
                        android:background="#73E1EF"
                        android:textStyle="bold"
                        android:textSize="@dimen/sp10"/>
                    <TextView
                        android:id="@+id/lineTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Line:"
                        android:padding="5dp"
                        android:background="#94E3ED"
                        android:textStyle="bold"
                        android:textSize="@dimen/sp10"/>
                </LinearLayout>
            </LinearLayout>
            <lecho.lib.hellocharts.view.PieChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="300dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/copyRightLy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/sp16"
            android:background="#EAE7E7" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="2dp"
            android:textColor="#9B9A9A"
            android:textSize="8sp"
            android:text="@string/copy_right" />
    </LinearLayout>
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_centerInParent="true"/>

</RelativeLayout>


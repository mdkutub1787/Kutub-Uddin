<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".HomeActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/top_rounded_bg"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/homeProfileNameTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Md Kutub Uddin" />

                <TextView
                    android:id="@+id/homeProfileBalanceTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/homeProfileNameTV"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="মোট জমা: 5000 টাকা" />

                <ImageButton
                    android:id="@+id/logout_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Logout"
                    android:src="@android:drawable/ic_lock_power_off"
                    app:tint="@android:color/white" />

            </RelativeLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="নোটিশ বোর্ড"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="16dp"/>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/carouselViewPager"
                android:layout_width="match_parent"
                android:layout_height="180dp" />

            <!-- গ্রিড আইকন ও টেক্সট -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:padding="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:useDefaultMargins="true">

                <!-- Event Calendar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"
                    android:id="@+id/eventCalendarLayout">
                    <ImageView
                        android:id="@+id/eventCalendarIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/deposit"
                        android:contentDescription="View Bill"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Bill"
                        android:textSize="12sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Organization -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">
                    <ImageView
                        android:id="@+id/nomineeImage"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ruls"
                        android:contentDescription="Organization"
                        android:clickable="true"
                        android:focusable="true"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ruls"
                        android:textSize="12sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Ministry -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">
                    <ImageView
                        android:id="@+id/ministryImage"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/revanue"
                        android:contentDescription="Ministry"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Revenue"
                        android:textSize="12sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- TV Channel -->
                <LinearLayout
                    android:id="@+id/tvChannelLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/television"
                        android:contentDescription="TV Channel"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TV Channel"
                        android:textSize="12sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- News Paper -->
                <LinearLayout
                    android:id="@+id/newsPaperLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/news"
                        android:contentDescription="News Paper"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="News Paper"
                        android:textSize="12sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Military Forces -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/air_force"
                        android:contentDescription="Military Forces"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Military Forces"
                        android:textSize="12sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Bank -->
                <LinearLayout
                    android:id="@+id/bankLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/bank"
                        android:contentDescription="Bank"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bank"
                        android:textSize="12sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Prominent Person -->
                <LinearLayout
                    android:id="@+id/prominentPersonLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/government"
                        android:contentDescription="Prominent Person"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prominent Person"
                        android:textSize="12sp"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/group"
                        android:contentDescription="Prominent Person"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prominent Person"
                        android:textSize="12sp"
                        android:gravity="center"/>
                </LinearLayout>
            </GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <ProgressBar
        android:id="@+id/homeProgressBar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="visible"
        android:indeterminate="true"
        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
        android:elevation="10dp"
        android:layout_marginTop="100dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 
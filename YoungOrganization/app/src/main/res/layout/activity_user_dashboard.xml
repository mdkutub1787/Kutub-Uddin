<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".UserDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white">

            <TextView
                android:id="@+id/headerMonth"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:text="মাস"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/cell_border"
                android:drawableEnd="@drawable/ic_filter_list_24" />

            <TextView
                android:id="@+id/headerYear"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1.5"
                android:text="বছর"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="15sp"
                android:gravity="center"
                android:background="@drawable/cell_border"
                android:drawableEnd="@drawable/ic_filter_list_24" />

            <TextView
                android:id="@+id/headerAmount"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:text="টাকা"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="15sp"
                android:gravity="center"
                android:background="@drawable/cell_border"
                android:drawableEnd="@drawable/ic_filter_list_24" />
        </LinearLayout>



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/adminDashboardRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            tools:itemCount="5"
            tools:listitem="@layout/item_bill_user" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/userDashboardProgressBar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminate="true"
        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
        android:elevation="10dp"
        android:layout_marginTop="100dp"/>

</RelativeLayout>
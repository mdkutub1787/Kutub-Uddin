<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".OrganizationInfoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="আমাদের সংস্থা"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="উদ্দেশ্য"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/objectivesTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="এখানে আপনার প্রতিষ্ঠানের উদ্দেশ্য সম্পর্কে লিখুন। আমাদের মূল লক্ষ্য হল সমাজের উন্নতি এবং সদস্যদের মধ্যে সহযোগিতা বৃদ্ধি করা।"
                    android:lineSpacingExtra="4dp"
                    android:textSize="16sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="নিয়মাবলী"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/rulesTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="১. সকল সদস্যকে প্রতিষ্ঠানের নিয়ম-কানুন মেনে চলতে হবে।\n২. মাসিক চাঁদা সময়মতো পরিশোধ করতে হবে।\n৩. একে অপরের প্রতি শ্রদ্ধাশীল হতে হবে।"
                    android:lineSpacingExtra="4dp"
                    android:textSize="16sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/organizationInfoProgressBar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminate="true"
            style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
            android:elevation="10dp"
            android:layout_marginTop="100dp"/>
    </LinearLayout>
</ScrollView> 